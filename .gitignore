!plots/synthetic/*/*/*-original.csv
!plots/synthetic/*/*/*.context.json

# UI state files (local)
UserInterface/extraction_state.json
UserInterface/batch_runs.json
UserInterface/synthetic_settings.json
UserInterface/synthetic_settings_v2.json
