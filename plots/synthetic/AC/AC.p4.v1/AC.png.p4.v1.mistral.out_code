import matplotlib.pyplot as plt

# Data
time_hours = [0, 2, 4, 6, 8, 10, 12, 14]
bacteria_count = [5.2, 5.8, 5.6, 5.0, 8.2, 6.2, 5.4, 7.6]

# Plot settings
plt.figure(figsize=(6, 4))
plt.plot(time_hours, bacteria_count, marker='o', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')

# Axis ranges
plt.xlim(0, 14)
plt.ylim(0, 9)

# Tick marks
plt.xticks(range(0, 15, 2))
plt.yticks(range(0, 10, 2))

# Grid and legend
plt.grid(True, linestyle='--', alpha=0.7)
plt.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AC\AC.p4.v1\AC-replot.p4.v1.png', bbox_inches='tight', dpi=300)
plt.close()