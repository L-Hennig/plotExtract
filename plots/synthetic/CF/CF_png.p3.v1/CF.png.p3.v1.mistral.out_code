import matplotlib.pyplot as plt
import os

# Data
time = [0, 3, 6, 9, 12, 15, 18, 21, 24]
condition1 = [5, 6.2, 8, 6, 4, 2, 3.2, 4, 4.2]
condition2 = [5.5, 5.8, 5.6, 5.1, 4.3, 3.8, 3.5, 3.3, 3.25]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time, condition1, marker='o', color='#1f77b4', label='Condition 1')
plt.plot(time, condition2, marker='o', color='#ff7f0e', linestyle='--', label='Condition 2')

# Axis labels and title
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.ylim(0, 9)
plt.xlim(0, 24)

# Legend
plt.legend()

# Grid
plt.grid(True, linestyle='--', alpha=0.7)

# Save the plot
output_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CF\CF_png.p3.v1\CF_png-replot.p3.v1.png"
os.makedirs(os.path.dirname(output_path), exist_ok=True)
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()