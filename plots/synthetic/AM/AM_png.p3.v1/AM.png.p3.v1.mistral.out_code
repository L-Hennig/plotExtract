import matplotlib.pyplot as plt

# Data
time_hours = [0, 2, 4, 6, 8, 10, 12, 14]
bacteria_count = [4.5, 9.5, 11.5, 11.7, 11.8, 11.9, 12.8, 10.8]

# Plot settings
plt.figure(figsize=(6, 4))
plt.plot(time_hours, bacteria_count, marker='o', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')

# Axis range
plt.xlim(0, 14)
plt.ylim(0, 14)

# Tick marks
plt.xticks(range(0, 15, 2))
plt.yticks(range(0, 15, 2))

# Grid and legend
plt.grid(False)
plt.legend()

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AM\AM_png.p3.v1\AM_png-replot.p3.v1.png", bbox_inches='tight', dpi=300)
plt.close()