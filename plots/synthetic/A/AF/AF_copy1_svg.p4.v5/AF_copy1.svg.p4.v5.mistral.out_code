import matplotlib.pyplot as plt

# Data
time_hours = [0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33]
bacterial_count = [6, 8, 11, 11.5, 9, 11.5, 13.5, 12, 13.5, 13, 11, 11.5]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time_hours, bacterial_count, marker='s', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL)')

# Axis ranges
plt.xlim(0, 35)
plt.ylim(0, 15)

# Ticks
plt.xticks(range(0, 36, 3))
plt.yticks(range(0, 16, 1))

# Grid
plt.grid(True, linestyle='--', alpha=0.7)

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AF\AF_copy1_svg.p4.v5\AF_copy1_svg-replot.p4.v5.png", bbox_inches='tight', dpi=300)
plt.close()