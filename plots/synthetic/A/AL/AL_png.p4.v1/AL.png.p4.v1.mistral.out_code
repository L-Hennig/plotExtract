import matplotlib.pyplot as plt

# Data
time = [0.0, 2.5, 5.0, 7.5, 10.0, 12.5, 15.0, 17.5, 20.0, 22.5]
bacteria_count = [7.0, 8.5, 8.7, 10.0, 10.0, 13.5, 12.0, 9.0, 12.5, 9.5]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time, bacteria_count, marker='o', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')

# Axis ranges
plt.xlim(0, 24)
plt.ylim(0, 14)

# Ticks
plt.xticks([0, 2.5, 5, 7.5, 10, 12.5, 15, 17.5, 20, 22.5])
plt.yticks([0, 2, 4, 6, 8, 10, 12, 14])

# Grid
plt.grid(True, linestyle='--', alpha=0.7)

# Legend
plt.legend()

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AL\AL_png.p4.v1\AL_png-replot.p4.v1.png", bbox_inches='tight', dpi=300)
plt.close()