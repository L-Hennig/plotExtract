import matplotlib.pyplot as plt
import os

data = {
    "Time (hours)": [0, 2, 4, 6, 8, 10, 12, 14, 16, 17],
    "Bacteria Count (CFU/mL) (Condition 1)": [5, 10.5, 11.5, 11.5, 12, 12, 12.5, 13, 11, 10.5]
}

plt.figure(figsize=(6, 4))
plt.plot(data["Time (hours)"], data["Bacteria Count (CFU/mL) (Condition 1)"], marker='o', color='#1f77b4', linestyle='-', linewidth=1.5, markersize=6)

plt.xlabel("Time (hours)")
plt.ylabel("Bacteria Count (CFU/mL)")
plt.xlim(0, 18)
plt.ylim(0, 14)
plt.xticks(range(0, 19, 2))
plt.yticks(range(0, 15, 2))
plt.grid(True, linestyle='--', alpha=0.6)

output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AK\AK_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "AK_png-replot.p4.v1.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()