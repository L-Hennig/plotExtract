plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AZ\AZ_png.p1.v1\AZ_png-replot.p1.v1.png", bbox_inches='tight', dpi=300)
plt.close()