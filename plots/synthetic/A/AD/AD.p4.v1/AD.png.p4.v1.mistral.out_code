import matplotlib.pyplot as plt

# Data
time = [0, 2, 4, 6, 8, 10, 12, 14]
bacterial_count = [5, 10, 11.5, 10, 11, 13.5, 11, 13.5]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time, bacterial_count, marker='o', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL)')

# Axis ranges
plt.xlim(0, 14)
plt.ylim(0, 15)

# Tick marks
plt.xticks(range(0, 15, 2))
plt.yticks(range(0, 16, 2))

# Grid
plt.grid(True, linestyle='--', alpha=0.6)

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AD\AD.p4.v1\AD-replot.p4.v1.png", bbox_inches='tight', dpi=300)
plt.close()