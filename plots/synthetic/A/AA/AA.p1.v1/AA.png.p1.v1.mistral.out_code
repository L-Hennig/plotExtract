```python
import matplotlib.pyplot as plt
import os

time_hours = [0, 2, 4, 6, 8, 10, 12, 14]
bacteria_count = [4.8, 5.0, 6.8, 7.2, 5.0, 6.9, 6.3, 6.8]

plt.figure(figsize=(6, 4))
plt.plot(time_hours, bacteria_count, marker='o', color='#1f77b4', linestyle='-', label='Condition 1')
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.xlim(0, 14)
plt.ylim(0, 8.5)
plt.xticks(range(0, 15, 2))
plt.yticks(range(0, 9, 1))
plt.grid(True, linestyle='--', alpha=0.7)
plt.legend()

os.makedirs(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AA\AA.p1.v1", exist_ok=True)
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AA\AA.p1.v1\AA-replot.p1.v1.png", bbox_inches='tight', dpi=300)
plt.close()
```