import matplotlib.pyplot as plt

# Data
time = [0, 2, 4, 6, 8, 10, 12, 14]
bacteria_count = [6.8, 8.9, 13.0, 11.5, 11.8, 12.5, 13.5, 10.2]

# Plot settings
plt.figure(figsize=(6, 4))
plt.plot(time, bacteria_count, marker='o', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')

# Axis ranges
plt.xlim(0, 14)
plt.ylim(0, 14)

# Tick marks
plt.xticks(range(0, 15, 2))
plt.yticks(range(0, 15, 2))

# Legend
plt.legend()

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AE\AE.p4.v1\AE-replot.p4.v1.png", bbox_inches='tight', dpi=300)
plt.close()