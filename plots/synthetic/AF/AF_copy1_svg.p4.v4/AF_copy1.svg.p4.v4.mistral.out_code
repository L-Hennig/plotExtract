import matplotlib.pyplot as plt

# Data
time_hours = [0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30]
bacterial_count = [6, 8, 11, 11.5, 9, 11.5, 13.5, 12, 13.5, 13, 11]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time_hours, bacterial_count, marker='s', color='#1f77b4', linestyle='-', linewidth=2, markersize=7)

# Axis labels
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL)', fontsize=12)

# Axis ranges
plt.xlim(0, 32)
plt.ylim(0, 15)

# Ticks
plt.xticks(range(0, 31, 3), fontsize=10)
plt.yticks(range(0, 16, 1), fontsize=10)

# Grid
plt.grid(False)

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AF\AF_copy1_svg.p4.v4\AF_copy1_svg-replot.p4.v4.png", bbox_inches='tight', dpi=300)
plt.close()