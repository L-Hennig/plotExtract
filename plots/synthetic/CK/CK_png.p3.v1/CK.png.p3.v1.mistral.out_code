import matplotlib.pyplot as plt
import pandas as pd
import os

data = {
    'Time (hours)': [0, 3, 5, 10, 12, 15, 24, 0, 3, 5, 10, 12, 15, 24],
    'Bacteria Count (CFU/mL)': [6.5, 6.2, 6.7, 5.5, 3.3, 3.0, 0, 6.1, 5.6, 5.2, 4.3, 4.0, 3.6, 2.9],
    'Condition': ['Condition 1']*7 + ['Condition 2']*7
}

df = pd.DataFrame(data)

plt.figure(figsize=(6, 5))
condition1 = df[df['Condition'] == 'Condition 1']
condition2 = df[df['Condition'] == 'Condition 2']

plt.plot(condition1['Time (hours)'], condition1['Bacteria Count (CFU/mL)'], marker='o', color='#1f77b4', label='Condition 1')
plt.plot(condition2['Time (hours)'], condition2['Bacteria Count (CFU/mL)'], marker='o', color='#ff7f0e', label='Condition 2')

plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.xlim(0, 25)
plt.ylim(0, 7)
plt.xticks(range(0, 26, 5))
plt.yticks(range(0, 8, 1))
plt.legend()

output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CK\CK_png.p3.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "CK_png-replot.p3.v1.png"), bbox_inches='tight', dpi=300)
plt.close()