import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Data preparation
data = {
    'Time_1': [0, 2, 4, 6, 8, 10],
    'CFU_1': [6.0, 6.2, 6.1, 6.0, 5.9, 5.8],
    'Time_2': [0, 2, 4, 6, 8],
    'CFU_2': [6.0, 5.5, 5.0, 4.5, 4.0],
    'Time_3': [0, 2, 4, 6, 8],
    'CFU_3': [6.0, 7.2, 7.3, 7.4, 7.8],
    'Time_4': [0, 2, 4, 6, 10, 12, 24],
    'CFU_4': [5.8, 5.0, 4.3, 4.0, 3.5, 3.7, 6.0]
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Plot Condition 1
ax.plot(data['Time_1'], data['CFU_1'], color='black', linestyle='-', marker='s', markersize=6, label='Condition 1')

# Plot Condition 2
ax.plot(data['Time_2'], data['CFU_2'], color='black', linestyle='-', marker='o', markersize=6, label='Condition 2')

# Plot Condition 3
ax.plot(data['Time_3'], data['CFU_3'], color='black', linestyle='-', marker='^', markersize=6, label='Condition 3')

# Plot Condition 4
ax.plot(data['Time_4'], data['CFU_4'], color='black', linestyle='-', marker='v', markersize=6, label='Condition 4')

# Set axis labels and limits
ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacteria Count (CFU/mL)', fontsize=12)
ax.set_xlim(0, 24)
ax.set_ylim(0, 8.5)

# Set x and y ticks
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 15, 20, 24])
ax.set_yticks([0, 2, 4, 6, 8])

# Add grid
ax.grid(True, linestyle='--', alpha=0.6)

# Add legend
ax.legend(loc='upper right', fontsize=10)

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CQ\CQ_png.p5.v1\CQ_png-replot.p5.v1.png", bbox_inches='tight', dpi=300)
plt.close()