import matplotlib.pyplot as plt

# Data
time_hours = [0, 2, 4, 6, 8, 10, 12, 13, 14]
bacteria_count = [5.5, 9, 12, 11, 10.2, 10.5, 12, 11.8, 11]

# Plot settings
plt.figure(figsize=(6, 4))
plt.plot(time_hours, bacteria_count, marker='o', color='#1f77b4', linestyle='-', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')

# Axis ranges
plt.xlim(0, 15)
plt.ylim(0, 13)

# Tick marks
plt.xticks(range(0, 16, 2))
plt.yticks(range(0, 14, 2))

# Legend
plt.legend()

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\BS\BS_png.p3.v1\BS_png-replot.p3.v1.png", bbox_inches='tight', dpi=300)
plt.close()