import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

data = {
    'Time (h)': [0, 2, 4, 6, 8, 10, 12, 16, 20, 24],
    'Condition 1': [6.0, 5.6, 5.3, 4.9, 4.5, 4.0, 3.8, 3.5, 3.0, 2.8],
    'Condition 2': [6.0, 6.7, 7.0, 7.3, 7.5, 7.6, None, None, None, 7.7]
}

df = pd.DataFrame(data)

plt.figure(figsize=(6, 5))
plt.plot(df['Time (h)'], df['Condition 1'], color='black', linestyle='-', marker='o', label='Condition 1')
plt.plot(df['Time (h)'], df['Condition 2'], color='black', linestyle='-', marker='o', mfc='white', label='Condition 2')

plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.ylim(0, 8.5)
plt.xlim(0, 24)
plt.yticks(np.arange(0, 9, 2))
plt.xticks(np.arange(0, 25, 5))

for i in range(len(df)):
    if not np.isnan(df['Condition 1'][i]):
        plt.plot(df['Time (h)'][i], df['Condition 1'][i], color='black', marker='o', markersize=6)
    if not np.isnan(df['Condition 2'][i]):
        plt.plot(df['Time (h)'][i], df['Condition 2'][i], color='black', marker='o', markersize=6, mfc='white')

plt.legend(loc='upper right', frameon=False)

plt.tight_layout()
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CO\CO_png.p5.v1\CO_png-replot.p5.v1.png", dpi=300)
plt.close()