import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 14, 24]
count_cond1 = [6.0, 5.8, 7.0, 8.2, 8.5, 8.7, 8.9, 9.0, 9.2]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
count_cond2 = [6.0, 4.0, 1.6, 1.5, 1.5, 1.5, 1.6, 1.8, 2.0, 2.5, 2.8]

time_cond3 = [0, 2, 4, 6, 8, 10, 12]
count_cond3 = [6.0, 2.5, 2.0, 2.0, 1.8, 1.5, 1.3]

time_cond4 = [0, 2, 4, 6, 8, 10, 14, 20, 24]
count_cond4 = [6.0, 7.3, 7.8, 7.8, 7.8, 7.8, 7.8, 7.9, 8.0]

time_cond5 = [0, 2, 4, 6, 8, 10, 12, 14, 16]
count_cond5 = [6.0, 2.8, 2.3, 2.0, 1.8, 1.7, 1.6, 1.3, 1.0]

# Plot
plt.figure(figsize=(8, 6))

# Condition 1
plt.plot(time_cond1, count_cond1, 'k-s', label='Condition 1', markersize=6, linewidth=1.5)

# Condition 2
plt.plot(time_cond2, count_cond2, 'k--^', label='Condition 2', markersize=6, linewidth=1.5)

# Condition 3
plt.plot(time_cond3, count_cond3, 'k:o', label='Condition 3', markersize=6, linewidth=1.5)

# Condition 4
plt.plot(time_cond4, count_cond4, 'k-.D', label='Condition 4', markersize=6, linewidth=1.5)

# Condition 5
plt.plot(time_cond5, count_cond5, 'k-', marker='o', markerfacecolor='k', markeredgecolor='k', label='Condition 5', markersize=6, linewidth=1.5)

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Axis limits
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks(np.arange(0, 27, 2))
plt.yticks(np.arange(0, 11, 1))

# Legend
plt.legend()

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FN\FN_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FN_png-replot.p4.v1.png"), dpi=300, bbox_inches='tight')
plt.close()