import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond1 = [6.0, 7.3, 8.0, 8.5, 8.7, 8.8, 8.9, 9.2]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond2 = [6.0, 6.1, 6.1, 6.1, 6.1, 6.1, 6.1, 6.1]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond3 = [5.8, 0.9, 2.3, 1.0, 0.8, 0.7, 0.7, 0.7]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time_cond1, count_cond1, 's-', color='black', label='Condition 1', markersize=8, linewidth=2)
plt.plot(time_cond2, count_cond2, '^--', color='black', label='Condition 2', markersize=8, linewidth=2, dashes=(5, 2))
plt.plot(time_cond3, count_cond3, 'o:', color='black', label='Condition 3', markersize=8, linewidth=2)

# Axis labels and title
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

# Axis limits
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks(np.arange(0, 26, 2))
plt.yticks(np.arange(0, 11, 1))

# Legend
plt.legend(loc='upper left', fontsize=10)

# Grid
plt.grid(False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FC\FC_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FC_png-replot.p4.v1.png"), bbox_inches='tight', dpi=300)
plt.close()