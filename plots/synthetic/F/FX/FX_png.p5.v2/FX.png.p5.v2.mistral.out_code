import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond1 = [6.1, 7.0, 7.0, 7.5, 8.0, 8.0, 8.0, 1.0]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond2 = [6.1, 8.5, 8.3, 8.7, 9.0, 9.2, 9.2, 9.0]

time_cond3 = [0, 2, 4, 6, 8]
log_cfu_cond3 = [6.1, 3.0, 1.0, 1.0, 1.0]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond4 = [6.1, 8.5, 8.3, 7.8, 8.0, 8.0, 1.0, 1.0]

time_cond5 = [0, 2, 4, 6, 8]
log_cfu_cond5 = [6.1, 2.0, 1.0, 1.0, 2.3]

time_cond6 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond6 = [6.1, 7.5, 8.7, 9.0, 9.2, 9.2, 9.2, 9.0]

# Plot setup
plt.figure(figsize=(8, 6))
plt.yscale('log')
plt.ylim(1, 10)
plt.xlim(0, 26)
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.title('')

# Plot each condition
plt.plot(time_cond1, log_cfu_cond1, 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time_cond2, log_cfu_cond2, '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5, dashes=(3, 2))
plt.plot(time_cond3, log_cfu_cond3, ':', color='black', marker='o', label='Condition 3', markersize=8, linewidth=1.5)
plt.plot(time_cond4, log_cfu_cond4, '-.', color='black', marker='D', label='Condition 4', markersize=8, linewidth=1.5)
plt.plot(time_cond5, log_cfu_cond5, 'o-', color='black', label='Condition 5', markersize=8, linewidth=1.5)
plt.plot(time_cond6, log_cfu_cond6, '--', color='black', marker='d', label='Condition 6', markersize=8, linewidth=1.5, dashes=(5, 2))

# Axis breaks (simulated by adjusting x-axis limits and adding break lines)
plt.xlim(0, 26)
ax = plt.gca()
ax.set_xlim(0, 26)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 24])

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FX\FX_png.p5.v2"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FX_png-replot.p5.v2.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()