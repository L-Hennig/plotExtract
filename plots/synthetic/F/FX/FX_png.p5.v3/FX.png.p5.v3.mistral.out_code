import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Data preparation
data = {
    'Time_1': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_1': [6.0, 7.0, 7.2, 7.8, 8.0, 8.2, 8.1, 8.0],
    'Time_2': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_2': [6.0, 8.5, 8.7, 9.0, 9.2, 9.2, 9.2, 9.2],
    'Time_3': [0, 2, 4, 6],
    'CFU_3': [6.0, 1.5, 1.0, 1.0],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [6.0, 8.5, 7.8, 8.0, 8.3, 8.5, 8.7, 8.8],
    'Time_5': [0, 2, 4, 6, 8, 10, 12],
    'CFU_5': [6.0, 3.0, 2.5, 2.3, 2.3, 2.3, 2.3],
    'Time_6': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_6': [6.0, 7.0, 8.5, 8.8, 9.0, 9.1, 9.1, 9.2]
}

# Plot setup
plt.figure(figsize=(8, 6))
plt.rcParams['font.family'] = 'Arial'
plt.rcParams['font.size'] = 12

# Plot each condition with specific line and marker styles
plt.plot(data['Time_1'], data['CFU_1'], color='black', linestyle='-', marker='s', markersize=6, label='Condition 1')
plt.plot(data['Time_2'], data['CFU_2'], color='black', linestyle='--', marker='^', markersize=6, label='Condition 2')
plt.plot(data['Time_3'], data['CFU_3'], color='black', linestyle=':', marker='o', markersize=6, label='Condition 3')
plt.plot(data['Time_4'], data['CFU_4'], color='black', linestyle='-.', marker='D', markersize=6, label='Condition 4')
plt.plot(data['Time_5'], data['CFU_5'], color='black', linestyle='-', marker='o', markersize=6, label='Condition 5')
plt.plot(data['Time_6'], data['CFU_6'], color='black', linestyle='--', marker='s', markersize=6, fillstyle='none', label='Condition 6')

# Axis setup
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['1', '2', '4', '6', '8', '10'])

# Add axis break on x-axis
plt.gca().spines['bottom'].set_bounds(0, 12)
plt.gca().spines['bottom'].set_position(('outward', 10))
plt.gca().set_xlim(0, 26)
plt.gca().set_xticks([0, 2, 4, 6, 8, 10, 12, 24])
x_break_start = 12.5
x_break_end = 20
plt.plot([x_break_start, x_break_end], [0, 0], color='white', linewidth=0)
plt.plot([x_break_start, x_break_start], [0, 1], color='black', linestyle='-', linewidth=1)
plt.plot([x_break_end, x_break_end], [0, 1], color='black', linestyle='-', linewidth=1)
d = 0.015
kwargs = dict(transform=plt.gca().transAxes, color='k', clip_on=False)
plt.gca().plot((1-d, 1+d), (-d, +d), **kwargs)
plt.gca().plot((1-d, 1+d), (1-d, 1+d), **kwargs)

# Add limit of detection line
plt.hlines(1, 0, 26, colors='black', linestyles='dashed', linewidth=0.8)

# Legend
plt.legend(loc='upper left', frameon=False)

# Save plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FX\FX_png.p5.v3\FX_png-replot.p5.v3.png", dpi=300, bbox_inches='tight')
plt.close()