import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Data preparation
data = {
    'Time_1': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_1': [6.0, 7.2, 8.5, 8.8, 8.9, 9.1, 9.1, 9.2],
    'Time_2': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_2': [5.8, 5.3, 5.7, 6.0, 5.8, 5.5, 5.3, 4.8],
    'Time_3': [0, 2, 4, 6, 8],
    'CFU_3': [6.0, 1.0, 0.7, 2.5, 2.8],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [7.5, 7.8, 8.0, 7.9, 7.9, 7.9, 7.9, 7.9]
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Plot Condition 1 (square markers, solid line)
ax.plot(data['Time_1'], data['CFU_1'], marker='s', linestyle='-', color='black', label='Condition 1')

# Plot Condition 2 (triangle markers, dashed line)
ax.plot(data['Time_2'], data['CFU_2'], marker='^', linestyle='--', color='black', label='Condition 2')

# Plot Condition 3 (circle markers, dotted line)
ax.plot(data['Time_3'], data['CFU_3'], marker='o', linestyle=':', color='black', label='Condition 3')

# Plot Condition 4 (diamond markers, solid line)
ax.plot(data['Time_4'], data['CFU_4'], marker='D', linestyle='-', color='black', label='Condition 4')

# Set axis labels and limits
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')
ax.set_xlim(0, 26)
ax.set_ylim(0, 10)

# Set log scale for y-axis
ax.set_yscale('log')

# Set y-ticks explicitly to match log10 scale
yticks = [1, 2, 4, 6, 8, 10]
ax.set_yticks(yticks)
ax.set_yticklabels([str(y) for y in yticks])

# Set x-ticks
xticks = [0, 2, 4, 6, 8, 10, 12, 24]
ax.set_xticks(xticks)

# Add grid
ax.grid(True, which='both', linestyle='--', linewidth=0.5)

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FG\FG_png.p5.v3\FG_png-replot.p5.v3.png", dpi=300, bbox_inches='tight')
plt.close()