import matplotlib.pyplot as plt
import pandas as pd
import os

data = {
    'Time (hours)': [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24],
    'Condition 1': [6.0, 7.5, 8.5, 8.7, 8.9, 9.1, 9.2, 9.2, 9.2, 9.2, 9.1],
    'Condition 2': [5.7, 5.3, 5.8, 6.0, 5.9, 5.6, 5.4, 5.2, 5.0, 4.8, 4.6],
    'Condition 3': [1.0, 0.5, 0.7, 2.7, 2.9, 1.0, 1.1, None, None, None, None],
    'Condition 4': [7.5, 7.6, 7.9, 7.9, 7.8, 7.8, 7.8, 7.8, 7.8, 7.8, 7.8]
}

df = pd.DataFrame(data)

plt.figure(figsize=(8, 6))
plt.plot(df['Time (hours)'], df['Condition 1'], 'k-s', label='Condition 1', markersize=6, linewidth=1.5)
plt.plot(df['Time (hours)'], df['Condition 2'], 'k--^', label='Condition 2', markersize=6, linewidth=1.5)
plt.plot(df['Time (hours)'], df['Condition 3'], 'k:o', label='Condition 3', markersize=6, linewidth=1.5)
plt.plot(df['Time (hours)'], df['Condition 4'], 'k-d', label='Condition 4', markersize=6, linewidth=1.5)

plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.ylim(0, 10)
plt.xlim(0, 26)
plt.xticks(range(0, 27, 2))
plt.yticks(range(0, 11, 1))
plt.grid(False)

output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FG\FG_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FG_png-replot.p4.v1.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()