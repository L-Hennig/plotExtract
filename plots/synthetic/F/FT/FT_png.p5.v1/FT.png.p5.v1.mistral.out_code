import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Data preparation
data = {
    'Time_1': [0, 2],
    'CFU_1': [6.0, 8.9],
    'Time_2': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_2': [6.0, 7.8, 7.9, 8.5, 8.9, 8.8, 8.9, 9.0],
    'Time_3': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_3': [6.0, 0.5, 0.7, 0.8, 1.0, 1.0, 1.0, 1.3],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [6.0, 8.3, 8.3, 8.2, 8.1, 8.0, 8.0, 8.2],
    'Time_5': [0, 2, 4, 6, 8, 10, 24],
    'CFU_5': [6.0, 3.5, 3.3, 2.8, 3.0, 3.2, 5.0],
    'Time_6': [0, 4, 24],
    'CFU_6': [6.0, 7.5, 2.8]
}

# Plot setup
plt.figure(figsize=(8, 6))
plt.yscale('log')
plt.ylim(0.1, 10)
plt.xlim(0, 26)
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.title('')

# Condition 1: solid line, square markers
plt.plot(data['Time_1'], data['CFU_1'], linestyle='-', color='black', marker='s', markersize=7, label='Condition 1')

# Condition 2: dashed line, triangle up markers
plt.plot(data['Time_2'], data['CFU_2'], linestyle='--', color='black', marker='^', markersize=7, label='Condition 2')

# Condition 3: dotted line, circle markers
plt.plot(data['Time_3'], data['CFU_3'], linestyle=':', color='black', marker='o', markersize=7, label='Condition 3')

# Condition 4: dash-dot line, diamond markers
plt.plot(data['Time_4'], data['CFU_4'], linestyle='-.', color='black', marker='D', markersize=7, label='Condition 4')

# Condition 5: solid line, filled circle markers
plt.plot(data['Time_5'], data['CFU_5'], linestyle='-', color='black', marker='o', markersize=7, mfc='black', label='Condition 5')

# Condition 6: dashed line, large filled circle markers
plt.plot(data['Time_6'], data['CFU_6'], linestyle='--', color='black', marker='o', markersize=8, mfc='black', label='Condition 6')

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FT\FT_png.p5.v1\FT_png-replot.p5.v1.png", dpi=300, bbox_inches='tight')
plt.close()