import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Data preparation
data = {
    'Time': [0, 2, 4, 6, 8, 10, 12, 24],
    'Condition 1': [6.1, 6.8, 7.2, 8.0, 8.2, 8.3, 8.3, 8.3],
    'Condition 2': [6.0, 3.0, 2.8, 2.9, 3.2, 6.5, 7.0, 7.8],
    'Condition 3': [6.0, 1.8, 1.3, 1.7, 1.5, 1.3, np.nan, 1.2],
    'Condition 4': [6.0, 7.5, 7.8, 7.9, 7.8, 7.8, np.nan, 7.8],
    'Condition 5': [6.0, 8.5, 9.0, 9.2, 9.1, 9.1, 9.2, 9.2],
    'Condition 6': [6.0, 3.0, 2.8, 3.0, 4.5, np.nan, np.nan, 7.5]
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Plot each condition with specific line and marker styles
ax.plot(data['Time'], data['Condition 1'], 's-', color='black', markersize=8, label='Condition 1')
ax.plot(data['Time'], data['Condition 2'], '^--', color='black', markersize=8, label='Condition 2')
ax.plot(data['Time'], data['Condition 3'], ':', color='black', marker='d', markersize=8, label='Condition 3')
ax.plot(data['Time'], data['Condition 4'], '-.', color='black', marker='D', markersize=8, label='Condition 4')
ax.plot(data['Time'], data['Condition 5'], 'o-', color='black', markersize=8, label='Condition 5')
ax.plot(data['Time'], data['Condition 6'], '--', color='black', marker='>', markersize=8, label='Condition 6')

# Set axis labels and limits
ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
ax.set_xlim(0, 26)
ax.set_ylim(0, 10)
ax.set_yscale('log')
ax.set_yticks([1, 2, 4, 6, 8, 10])
ax.set_yticklabels(['1', '2', '4', '6', '8', '10'])

# Set x-ticks
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_xticklabels(['0', '2', '4', '6', '8', '10', '12', '', '', '24'])

# Add axis break indicator
ax.plot([12.5, 13.5], [0.5, 0.5], color='black', linewidth=1.5, clip_on=False)
ax.plot([12.5, 13.5], [10.5, 10.5], color='black', linewidth=1.5, clip_on=False)

# Add legend
ax.legend(loc='upper left', fontsize=10)

# Save the plot
plt.tight_layout()
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FY\FY_png.p5.v6\FY_png-replot.p5.v6.png", dpi=300)
plt.close()