import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 20, 24]
count_cond1 = [6.1, 6.8, 7.2, 8.0, 8.2, 8.3, 8.3, 8.3, 8.3]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond2 = [6.1, 3.0, 2.8, 2.9, 3.5, 7.5, 7.8, 7.8]

time_cond3 = [0, 2, 4, 6, 8]
count_cond3 = [6.1, 2.0, 1.3, 1.5, 2.2]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 20, 24]
count_cond4 = [6.1, 7.5, 7.8, 7.9, 7.8, 7.7, 7.8, 9.2, 7.7]

time_cond5 = [0, 2, 4, 6, 8, 10, 12, 20, 24]
count_cond5 = [6.1, 7.8, 8.6, 9.0, 9.1, 9.2, 9.2, 9.2, 9.2]

time_cond6 = [0, 2, 4, 6, 8, 10, 12, 20, 24]
count_cond6 = [6.1, 2.8, 2.5, 2.6, 2.2, 1.5, 1.3, 1.2, 1.1]

# Plot settings
plt.figure(figsize=(8, 6))
plt.yscale('log')
plt.ylim(1, 10)
plt.xlim(0, 26)
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Plot each condition with specific line and marker styles
plt.plot(time_cond1, count_cond1, 'k-s', label='Condition 1', linestyle='-', markersize=6)
plt.plot(time_cond2, count_cond2, 'k--^', label='Condition 2', linestyle='--', markersize=6)
plt.plot(time_cond3, count_cond3, 'k:o', label='Condition 3', linestyle=':', markersize=6)
plt.plot(time_cond4, count_cond4, 'k-.d', label='Condition 4', linestyle='-.', markersize=6)
plt.plot(time_cond5, count_cond5, 'k-', marker='o', label='Condition 5', markersize=6)
plt.plot(time_cond6, count_cond6, 'k--v', label='Condition 6', linestyle='--', markersize=6)

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FY\FY_png.p4.v2"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FY_png-replot.p4.v2.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()