import os
import matplotlib.pyplot as plt

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/F/FY\FY_png.pv2_prompt_4.v1\FY_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
curves_data = [
    {
        "label": "Condition 1",
        "points": [
            {"x": 0, "y": 6.1}, {"x": 2, "y": 7.0}, {"x": 4, "y": 7.2},
            {"x": 6, "y": 8.0}, {"x": 8, "y": 8.2}, {"x": 10, "y": 8.1},
            {"x": 12, "y": 8.3}, {"x": 20, "y": 8.3}, {"x": 24, "y": 8.4}
        ],
        "marker": "s",
        "linestyle": "-",
        "color": "black"
    },
    {
        "label": "Condition 2",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 3.0}, {"x": 4, "y": 2.8},
            {"x": 6, "y": 2.7}, {"x": 8, "y": 2.9}, {"x": 10, "y": 3.0},
            {"x": 20, "y": 7.8}, {"x": 24, "y": 7.9}
        ],
        "marker": "^",
        "linestyle": "--",
        "color": "black"
    },
    {
        "label": "Condition 3",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 2.0}, {"x": 4, "y": 1.5},
            {"x": 6, "y": 1.8}, {"x": 8, "y": 1.7}, {"x": 20, "y": 1.5},
            {"x": 24, "y": 1.4}
        ],
        "marker": "o",
        "linestyle": ":",
        "color": "black"
    },
    {
        "label": "Condition 4",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 7.5}, {"x": 4, "y": 7.8},
            {"x": 6, "y": 7.9}, {"x": 8, "y": 7.8}, {"x": 10, "y": 7.7},
            {"x": 12, "y": 8.5}, {"x": 20, "y": 7.8}, {"x": 24, "y": 7.8}
        ],
        "marker": "D",
        "linestyle": "-.",
        "color": "black"
    },
    {
        "label": "Condition 5",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 2.5}, {"x": 4, "y": 2.3},
            {"x": 6, "y": 2.2}, {"x": 8, "y": 2.3}, {"x": 10, "y": 2.4},
            {"x": 20, "y": 1.3}
        ],
        "marker": "v",
