import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import os

# Data preparation
data = {
    'Time_1': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_1': [6.0, 7.0, 7.2, 8.0, 8.2, 8.2, 8.2, 8.3],
    'Time_2': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_2': [6.0, 3.0, 2.5, 2.5, 3.0, 3.5, 3.8, 7.8],
    'Time_3': [0, 2, 4, 6, 8],
    'CFU_3': [6.0, 2.0, 1.0, 2.0, 1.5],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [6.0, 7.5, 7.8, 7.8, 7.8, 7.8, 7.8, 7.8],
    'Time_5': [0, 2, 4, 6, 8, 24],
    'CFU_5': [6.0, 8.5, 9.0, 9.2, 9.2, 7.8],
    'Time_6': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_6': [6.0, 3.0, 2.5, 2.5, 4.5, 5.0, 6.5, 7.7]
}

# Plot styling
plt.figure(figsize=(8, 6))
plt.rcParams['font.family'] = 'Arial'
plt.rcParams['font.size'] = 12

# Line and marker styles for each condition
styles = [
    {'color': 'black', 'marker': 's', 'linestyle': '-', 'linewidth': 1.5, 'markersize': 6, 'label': 'Condition 1'},
    {'color': 'black', 'marker': '^', 'linestyle': '--', 'linewidth': 1.5, 'markersize': 6, 'label': 'Condition 2'},
    {'color': 'black', 'marker': 'o', 'linestyle': ':', 'linewidth': 1.5, 'markersize': 6, 'label': 'Condition 3'},
    {'color': 'black', 'marker': 'D', 'linestyle': '-.', 'linewidth': 1.5, 'markersize': 6, 'label': 'Condition 4'},
    {'color': 'black', 'marker': 'H', 'linestyle': '-', 'linewidth': 1.5, 'dash_capstyle': 'round', 'markersize': 6, 'label': 'Condition 5'},
    {'color': 'black', 'marker': 'v', 'linestyle': '--', 'linewidth': 1.5, 'markersize': 6, 'label': 'Condition 6'}
]

# Plot each condition
for i, style in enumerate(styles, 1):
    time_key = f'Time_{i}'
    cfu_key = f'CFU_{i}'
    plt.plot(data[time_key], data[cfu_key],
             color=style['color'],
             marker=style['marker'],
             linestyle=style['linestyle'],
             linewidth=style['linewidth'],
             markersize=style['markersize'],
             label=style['label'])

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['1', '2', '4', '6', '8', '10'])
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])

# Axis break indication
plt.annotate('', xy=(12.5, 0), xytext=(19.5, 0),
             xycoords='axes fraction', textcoords='axes fraction',
             arrowprops=dict(arrowstyle='-', color='black', lw=1.5))
plt.annotate('', xy=(12.5, 0.02), xytext=(19.5, 0.02),
             xycoords='axes fraction', textcoords='axes fraction',
             arrowprops=dict(arrowstyle='-', color='black', lw=1.5))

# Legend
plt.legend(loc='upper left', frameon=False, numpoints=1)

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FY\FY_png.p5.v4"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FY_png-replot.p5.v4.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()