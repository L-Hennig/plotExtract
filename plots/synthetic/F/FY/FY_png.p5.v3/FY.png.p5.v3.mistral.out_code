import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond1 = [6.1, 6.8, 7.2, 8.0, 8.2, 8.1, 8.2, 8.3]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond2 = [6.0, 3.0, 2.8, 2.7, 3.5, 3.8, 7.5, 7.8]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond3 = [6.0, 1.8, 1.2, 1.5, 1.7, 1.0, np.nan, 1.3]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond4 = [6.0, 7.5, 7.8, 7.8, 7.7, 7.7, 7.8, 7.8]

time_cond5 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond5 = [6.0, 8.5, 9.0, 9.2, 9.2, 9.3, 9.3, 9.3]

time_cond6 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond6 = [6.0, 3.0, 2.8, 3.0, 4.5, 5.0, 7.8, 7.7]

# Plot setup
plt.figure(figsize=(8, 6))
plt.rcParams['font.size'] = 12
plt.rcParams['axes.linewidth'] = 1.5

# Plot each condition
plt.plot(time_cond1, cfu_cond1, color='black', linestyle='-', marker='s', markersize=8, label='Condition 1')
plt.plot(time_cond2, cfu_cond2, color='black', linestyle='--', marker='^', markersize=8, label='Condition 2')
plt.plot(time_cond3, cfu_cond3, color='black', linestyle=':', marker='o', markersize=8, label='Condition 3')
plt.plot(time_cond4, cfu_cond4, color='black', linestyle='-.', marker='D', markersize=8, label='Condition 4')
plt.plot(time_cond5, cfu_cond5, color='black', linestyle='-', marker='H', markersize=8, label='Condition 5')
plt.plot(time_cond6, cfu_cond6, color='black', linestyle='--', marker='>', markersize=8, label='Condition 6')

# Axis labels and limits
plt.xlabel('Time (hours)', fontsize=14)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=14)
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['1', '2', '4', '6', '8', '10'])

# Axis breaks (simulated by adjusting x-axis ticks)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])

# Grid and legend
plt.grid(True, which="both", ls="--", linewidth=0.5)
plt.legend(loc='upper right', fontsize=10, frameon=True)

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FY\FY_png.p5.v3"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FY_png-replot.p5.v3.png"), dpi=300, bbox_inches='tight')
plt.close()