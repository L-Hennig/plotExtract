import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond1 = [6.0, 5.7, 7.2, 8.0, 8.3, 8.5, 8.7, 9.0]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond2 = [6.0, 5.3, 5.3, 5.3, 5.3, 5.3, 5.3, 5.5]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond3 = [5.8, 1.3, 1.0, 1.0, 1.3, 1.7, 1.7, 2.7]

# Create plot
plt.figure(figsize=(6, 5))
plt.plot(time_cond1, cfu_cond1, 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time_cond2, cfu_cond2, '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5, markerfacecolor='none')
plt.plot(time_cond3, cfu_cond3, 'o:', color='black', label='Condition 3', markersize=8, linewidth=1.5, markerfacecolor='none')

# Axis labels and title
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xticks(np.arange(0, 27, 2))
plt.yticks(np.arange(0, 11, 1))
plt.grid(False)

# Legend
plt.legend(loc='upper left', fontsize=10)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FA\FA_png.p5.v2"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FA_png-replot.p5.v2.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()