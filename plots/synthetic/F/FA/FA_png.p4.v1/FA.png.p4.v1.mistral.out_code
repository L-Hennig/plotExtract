import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 1, 2, 6, 8, 10, 14, 24]
bact_count_cond1 = [6.0, 5.5, 5.7, 8.0, 8.2, 8.5, 8.8, 9.0]

time_cond2 = [0, 1, 2, 4, 6, 8, 10, 12, 16, 24]
bact_count_cond2 = [6.0, 5.3, 5.2, 5.2, 5.2, 5.2, 5.3, 5.3, 5.4, 5.5]

time_cond3 = [0, 1, 2, 4, 6, 8, 10, 12, 14, 16, 24]
bact_count_cond3 = [5.8, 1.3, 1.0, 1.0, 1.0, 1.3, 1.7, 1.7, 2.0, 2.0, 2.5]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time_cond1, bact_count_cond1, 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time_cond2, bact_count_cond2, '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5, dashes=(4, 2))
plt.plot(time_cond3, bact_count_cond3, 'o:', color='black', label='Condition 3', markersize=8, linewidth=1.5)

# Axis labels and title
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xticks(np.arange(0, 27, 2))
plt.yticks(np.arange(0, 11, 1))
plt.yscale('log')
plt.grid(False)

# Legend
plt.legend(loc='upper right', fontsize=10)

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FA\FA_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FA_png-replot.p4.v1.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()