```python
import matplotlib.pyplot as plt
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 24]
bact_count_cond1 = [6.0, 5.6, 7.0, 8.0, 8.3, 8.5, 8.8, 8.9, 8.9, 9.0]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 24]
bact_count_cond2 = [6.0, 5.3, 5.2, 5.2, 5.3, 5.3, 5.3, 5.3, 5.3, 5.5]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 24]
bact_count_cond3 = [5.8, 1.3, 1.0, 1.1, 1.3, 2.0, 1.7, 1.8, 2.0, 2.7]

# Create plot
fig, ax = plt.subplots()
ax.plot(time_cond1, bact_count_cond1, 's-', color='black', label='Condition 1', markersize=7)
ax.plot(time_cond2, bact_count_cond2, '^--', color='black', label='Condition 2', markersize=7, linestyle='--')
ax.plot(time_cond3, bact_count_cond3, 'o:', color='black', label='Condition 3', markersize=7, linestyle=':')

# Set axis labels and scale
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')
ax.set_yscale('log')
ax.set_ylim(1, 10)
ax.set_xlim(0, 26)

# Add legend
ax.legend()

# Save plot
os.makedirs(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FA\FA_png.p1.v1", exist_ok=True)
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FA\FA_png.p1.v1\FA_png-replot.p1.v1.png", bbox_inches='tight', dpi=300)
plt.close()
```