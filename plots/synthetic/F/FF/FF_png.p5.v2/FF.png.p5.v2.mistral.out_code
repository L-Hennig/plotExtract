import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 6, 8, 10, 24]
log_cfu_cond1 = [6.0, 7.8, 8.6, 8.9, 9.0, 9.1]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond2 = [5.2, 4.9, 4.9, 4.9, 5.2, 5.3, 5.4, 5.6]

time_cond3 = [0, 2, 4, 6, 8]
log_cfu_cond3 = [6.0, 1.3, 1.0, 1.0, 1.0]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond4 = [6.0, 7.2, 8.2, 7.9, 8.5, 8.7, 9.0, 9.2]

# Plot settings
plt.figure(figsize=(8, 6))
plt.rcParams['font.size'] = 12
plt.rcParams['axes.linewidth'] = 1.5

# Plot each condition
plt.plot(time_cond1, log_cfu_cond1, 's-', color='black', markersize=8, linewidth=2, label='Condition 1')
plt.plot(time_cond2, log_cfu_cond2, '^--', color='black', markersize=8, linewidth=2, label='Condition 2')
plt.plot(time_cond3, log_cfu_cond3, 'o:', color='black', markersize=8, linewidth=2, label='Condition 3')
plt.plot(time_cond4, log_cfu_cond4, 'D-', color='black', markersize=8, linewidth=2, label='Condition 4')

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xticks(np.arange(0, 26, 2))
plt.yticks(np.arange(0, 11, 1))
plt.xlabel('Time (hours)', fontsize=14)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=14)
plt.legend(loc='upper left', fontsize=12)

# Grid and layout
plt.grid(False)
plt.tight_layout()

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FF\FF_png.p5.v2"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FF_png-replot.p5.v2.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()