import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 6, 8, 10, 24]
log_cfu_cond1 = [6.1, 7.3, 7.8, 8.3, 8.5, 9.2]

time_cond2 = [0, 2, 4, 6, 8, 10, 24]
log_cfu_cond2 = [6.1, 2.5, 2.6, 2.3, 3.3, 1.3, 1.3]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond3 = [6.1, 3.6, 3.2, 3.3, 3.3, 3.6, 4.1, 6.7]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond4 = [6.1, 7.8, 8.3, 8.4, 8.4, 8.2, 8.1, 8.3]

# Plot setup
plt.figure(figsize=(8, 6))
plt.rcParams['font.family'] = 'Arial'
plt.rcParams['font.size'] = 12

# Plot each condition
plt.plot(time_cond1, log_cfu_cond1, 'k-s', label='Condition 1', markersize=8, linewidth=2)
plt.plot(time_cond2, log_cfu_cond2, 'k--^', label='Condition 2', markersize=8, linewidth=2)
plt.plot(time_cond3, log_cfu_cond3, 'k:o', label='Condition 3', markersize=8, linewidth=2)
plt.plot(time_cond4, log_cfu_cond4, 'k-d', label='Condition 4', markersize=8, linewidth=2)

# Axis labels and limits
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks(np.arange(0, 27, 2))
plt.yticks(np.arange(0, 11, 1))

# Grid and legend
plt.grid(False)
plt.legend(loc='upper left', fontsize=10)

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FL\FL_png.p5.v2"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FL_png-replot.p5.v2.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()