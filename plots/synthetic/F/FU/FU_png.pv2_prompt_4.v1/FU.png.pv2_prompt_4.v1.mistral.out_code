import os
import matplotlib.pyplot as plt

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/F/FU\FU_png.pv2_prompt_4.v1\FU_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

curves_data = [
    {
        "label": "Condition 1",
        "points": [
            {"x": 0, "y": 6.1}, {"x": 2, "y": 7.3}, {"x": 4, "y": 8.5},
            {"x": 6, "y": 9.0}, {"x": 8, "y": 9.5}, {"x": 10, "y": 9.7},
            {"x": 12, "y": 9.8}, {"x": 24, "y": 9.9}
        ],
        "marker": "s",
        "linestyle": "-",
        "color": "black"
    },
    {
        "label": "Condition 2",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 2.0}, {"x": 4, "y": 1.0},
            {"x": 6, "y": 1.0}, {"x": 8, "y": 1.0}, {"x": 10, "y": 1.0},
            {"x": 24, "y": 1.0}
        ],
        "marker": "^",
        "linestyle": "--",
        "color": "black"
    },
    {
        "label": "Condition 3",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 1.0}, {"x": 4, "y": 0.5},
            {"x": 6, "y": 0.5}, {"x": 24, "y": 2.0}
        ],
        "marker": "o",
        "linestyle": ":",
        "color": "black"
    },
    {
        "label": "Condition 4",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 7.0}, {"x": 4, "y": 7.5},
            {"x": 6, "y": 7.8}, {"x": 8, "y": 8.0}, {"x": 10, "y": 8.2},
            {"x": 12, "y": 8.3}, {"x": 24, "y": 8.3}
        ],
        "marker": "D",
        "linestyle": "-.",
        "color": "black"
    },
    {
        "label": "Condition 5",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 2.5}, {"x": 4, "y": 2.3},
            {"x": 6, "y": 2.3}, {"x": 8, "y": 2.3}, {"x": 10, "y": 2.3},
            {"x": 24, "y": 1.5}
        ],
        "marker": "o",
        "linestyle": "-",
        "color": "black",
        "fillstyle": "none"
    },
    {
        "label": "Condition 6",
        "points": [
            {"x": 0, "y": 5.8}, {"x": 2, "y": 0.5}, {"x": 24, "y": 1.8}
        ],
        "marker": "s",
        "linestyle": "--",
        "color": "black",
        "fillstyle": "none"
    }
]

fig, ax = plt.subplots(figsize=(8, 6))

for curve in curves_data:
    x_vals = [p["x"] for p in curve["points"]]
    y_vals = [p["y"] for p in curve["points"]]
    ax.plot(x_vals, y_vals,
            marker=curve["marker"],
            linestyle=curve["linestyle"],
            color=curve["color"],
            fillstyle=curve.get("fillstyle", "full"),
            label=curve["label"])

ax.set_xlabel("Time (hours)", fontsize=12)
ax.set_ylabel("Bacterial Count (CFU/mL) (log10 scale)", fontsize=12)
ax.set_xlim(0, 26)
ax.set_ylim(0, 10)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 24])
ax.set_xticklabels(["0", "2", "4", "6", "8", "10", "12", "24"])
ax.set_yticks([0, 2, 4, 6, 8, 10])
ax.set_yticklabels(["0", "2", "4", "6", "8", "10"])

ax.plot([12, 12.5], [10.2, 10.2], color="black", clip_on=False, transform=ax.get_xaxis_transform())
ax.plot([12, 12.5], [10.5, 10.5], color="black", clip_on=False, transform=ax.get_xaxis_transform())
ax.plot([20, 20.5], [10.2, 10.2], color="black", clip_on=False, transform=ax.get_xaxis_transform())
ax.plot([20, 20.5], [10.5, 10.5], color="black", clip_on=False, transform=ax.get_xaxis_transform())

ax.legend(loc="upper left", fontsize=10)
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()