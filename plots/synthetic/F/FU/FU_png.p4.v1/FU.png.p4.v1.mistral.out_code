import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time = [0, 2, 4, 6, 8, 10, 12, 24]

condition1 = [6.0, 7.5, 8.5, 9.0, 9.3, 9.6, 9.8, 10.0]
condition2 = [6.0, 6.7, 7.5, 8.0, 8.2, 8.1, 8.0, 8.0]
condition3 = [6.0, 3.0, 1.0, 1.0, 1.3, 1.5, 1.7, 2.0]
condition4 = [6.0, 7.0, 7.8, 8.0, 8.0, 8.0, 8.1, 8.2]
condition5 = [6.0, 2.5, 2.3, 2.3, 2.3, 2.3, 2.3, 1.5]
condition6 = [6.0, 5.8, 2.2, 1.0, 1.0, 1.0, 1.0, 1.5]

# Plot settings
plt.figure(figsize=(8, 6))

# Plotting each condition
plt.plot(time, condition1, 'k-s', label='Condition 1', markersize=8, linewidth=2)
plt.plot(time, condition2, 'k--^', label='Condition 2', markersize=8, linewidth=2)
plt.plot(time, condition3, 'k:o', label='Condition 3', markersize=8, linewidth=2)
plt.plot(time, condition4, 'k-D', label='Condition 4', markersize=8, linewidth=2, markerfacecolor='none')
plt.plot(time, condition5, 'k-', label='Condition 5', marker='o', markersize=8, linewidth=2)
plt.plot(time, condition6, 'k--', label='Condition 6', marker='d', markersize=8, linewidth=2, markerfacecolor='none')

# Axis labels
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

# Axis limits
plt.xlim(0, 26)
plt.ylim(0, 10.5)

# Ticks
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
plt.yticks([0, 2, 4, 6, 8, 10])

# Axis break indication
plt.gca().spines['bottom'].set_bounds(0, 12)
plt.gca().spines['right'].set_visible(False)
plt.gca().spines['top'].set_visible(False)

# Add axis break
plt.annotate('', xy=(12, 0), xycoords='data', xytext=(20, 0), textcoords='data',
             arrowprops=dict(arrowstyle='-', linestyle='--', color='k'))
plt.annotate('', xy=(12, 10.5), xycoords='data', xytext=(20, 10.5), textcoords='data',
             arrowprops=dict(arrowstyle='-', linestyle='--', color='k'))

# Legend
plt.legend(loc='upper left', fontsize=10)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FU\FU_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FU_png-replot.p4.v1.png"), bbox_inches='tight', dpi=300)
plt.close()