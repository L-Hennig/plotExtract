import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 24]
log_cond1 = [6.0, 7.5, 8.5, 9.0, 9.5, 9.8, 10.0]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cond2 = [6.0, 7.0, 7.5, 8.0, 8.2, 8.1, 8.1, 8.2]

time_cond3 = [0, 2, 4, 6, 8, 24]
log_cond3 = [6.0, 1.0, 0.5, 0.5, 1.0, 2.0]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cond4 = [6.0, 7.0, 7.5, 8.0, 8.0, 8.1, 8.1, 8.2]

time_cond5 = [0, 2, 4, 6, 8, 10, 24]
log_cond5 = [6.0, 3.0, 2.5, 2.5, 2.5, 2.5, 1.5]

time_cond6 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cond6 = [6.0, 6.0, 6.5, 7.5, 8.0, 8.1, 8.1, 8.2]

# Create plot
plt.figure(figsize=(8, 6))
plt.plot(time_cond1, log_cond1, 'k-s', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time_cond2, log_cond2, 'k--^', label='Condition 2', markersize=8, linewidth=1.5)
plt.plot(time_cond3, log_cond3, 'k:o', label='Condition 3', markersize=8, linewidth=1.5)
plt.plot(time_cond4, log_cond4, 'k-D', label='Condition 4', markersize=8, linewidth=1.5, markerfacecolor='none')
plt.plot(time_cond5, log_cond5, 'k-', label='Condition 5', marker='o', markersize=8, linewidth=1.5)
plt.plot(time_cond6, log_cond6, 'k--', label='Condition 6', marker='D', markersize=8, linewidth=1.5, markerfacecolor='none')

# Axis labels and title
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.yscale('log')
plt.ylim(0.5, 12)
plt.xlim(-1, 26)

# Custom x-ticks to match original plot
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24], ['0', '2', '4', '6', '8', '10', '12', '', '', '24'])

# Axis break indication
plt.plot([12.5, 13.5], [0.4, 0.4], 'k-', lw=1.5)
plt.plot([12.5, 13.5], [12, 12], 'k-', lw=1.5)

# Grid and layout
plt.grid(False)
plt.legend(loc='upper left', fontsize=10)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FU\FU_png.p5.v3"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FU_png-replot.p5.v3.png"), dpi=300, bbox_inches='tight')
plt.close()