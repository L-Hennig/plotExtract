import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time = {
    'Condition 1': [0, 2, 4, 6, 8, 10, 12, 24],
    'Condition 2': [0, 2, 4, 6, 8, 10, 12, 24],
    'Condition 3': [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24],
    'Condition 4': [0, 2, 4, 6, 8, 10, 12, 24],
    'Condition 5': [0, 2, 4, 6, 8, 10, 12, 14, 20],
    'Condition 6': [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
}

bacterial_count = {
    'Condition 1': [6.1, 5.9, 6.3, 6.8, 7.2, 7.5, 8.0, 8.0],
    'Condition 2': [6.1, 7.8, 8.2, 8.0, 8.6, 8.8, 9.0, 8.3],
    'Condition 3': [6.1, 2.5, 1.0, 1.2, 2.7, 2.0, 2.2, 1.6, 1.5, 1.3, 0.7],
    'Condition 4': [6.1, 3.8, 8.1, 8.0, 7.9, 8.0, 1.5, 7.8],
    'Condition 5': [6.1, 5.8, 2.3, 2.5, 2.8, 3.0, 2.5, 2.3, np.nan],
    'Condition 6': [6.1, 3.0, 2.7, 1.5, 1.3, np.nan, np.nan, 1.2, 1.3, 1.1, 0.8]
}

# Plot settings
plt.figure(figsize=(8, 6))
markers = ['s', '^', 'o', 'D', 'o', '>']
linestyles = ['-', '--', ':', '-.', '-', '--']
colors = ['black', 'black', 'black', 'black', 'black', 'black']

# Plotting each condition
for i, condition in enumerate(bacterial_count.keys()):
    plt.plot(time[condition], bacterial_count[condition],
             marker=markers[i],
             linestyle=linestyles[i],
             color=colors[i],
             label=condition)

# Axis labels and title
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.ylim(0, 10)
plt.xlim(0, 26)

# Legend
plt.legend(loc='best')

# Save plot
output_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FR\FR_png.p4.v1\FR_png-replot.p4.v1.png"
os.makedirs(os.path.dirname(output_path), exist_ok=True)
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()