import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

data = {
    'Time_1': [0, 2, 4, 6, 8, 10, 24],
    'CFU_1': [6.2, 7.2, 8.0, 8.2, 8.3, 8.5, 8.5],
    'Time_2': [0, 2, 4, 6, 8, 10, 24],
    'CFU_2': [6.0, 6.3, 2.0, 2.0, 1.0, 1.0, 1.3],
    'Time_3': [0, 2, 4, 6, 8, 10, 24],
    'CFU_3': [6.0, 1.8, 1.0, 1.3, 2.0, 2.0, 1.0],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [6.0, 6.3, 7.0, 8.0, 8.5, 8.8, 8.9, 8.9],
    'Time_5': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_5': [6.0, 3.0, 2.5, 2.5, 2.3, 2.0, 1.5, 1.0]
}

plt.figure(figsize=(8, 6))
plt.plot(data['Time_1'], data['CFU_1'], 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(data['Time_2'], data['CFU_2'], '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5)
plt.plot(data['Time_3'], data['CFU_3'], ':', color='black', marker='o', label='Condition 3', markersize=8, linewidth=1.5)
plt.plot(data['Time_4'], data['CFU_4'], 'D-', color='black', label='Condition 4', markersize=8, linewidth=1.5)
plt.plot(data['Time_5'], data['CFU_5'], 'o-', color='black', label='Condition 5', markersize=8, linewidth=1.5, markerfacecolor='none')

plt.axhline(y=1, color='black', linestyle='--', linewidth=1)
plt.text(24.5, 1, 'LOD', verticalalignment='center', fontsize=10)

plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24], fontsize=10)
plt.yticks([0, 1, 2, 4, 6, 8, 10], fontsize=10)
plt.legend(loc='upper right', fontsize=10)

plt.gca().set_xlim([-1, 26])
plt.gca().set_ylim([0, 10])
plt.gca().set_xticks([0, 2, 4, 6, 8, 10, 12, 24])
plt.gca().set_xticklabels([0, 2, 4, 6, 8, 10, 12, 24])
plt.gca().set_yticks([0, 1, 2, 4, 6, 8, 10])
plt.gca().set_yscale('log')
plt.gca().yaxis.set_major_formatter(plt.FuncFormatter(lambda y, _: f'{int(y)}' if y == int(y) else f'{y}'))

x_break_start, x_break_end = 13, 19
plt.gca().axvspan(x_break_start, x_break_end, facecolor='white', edgecolor='none', zorder=2)
plt.gca().plot([x_break_start, x_break_end], [0, 0], color='black', linewidth=1, clip_on=False)
plt.gca().plot([x_break_start, x_break_end], [10, 10], color='black', linewidth=1, clip_on=False)
plt.gca().text((x_break_start + x_break_end) / 2, -0.5, '//', ha='center', va='center', fontsize=14)

plt.tight_layout()
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FZ\FZ_png.p5.v2\FZ_png-replot.p5.v2.png", dpi=300)
plt.close()