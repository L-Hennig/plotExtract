import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 24]
cfu_cond1 = [6.2, 7.2, 8.0, 8.1, 8.3, 8.4, 8.5]

time_cond2 = [0, 2, 4, 6, 8, 10, 24]
cfu_cond2 = [6.0, 6.2, 8.0, 8.3, 8.8, 9.0, 1.0]

time_cond3 = [0, 2, 4, 24]
cfu_cond3 = [6.0, 2.0, 1.0, 1.0]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond4 = [6.0, 6.5, 6.8, 7.8, 8.5, 8.7, 8.9, 8.8]

time_cond5 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond5 = [6.0, 3.0, 2.5, 2.3, 2.5, 2.0, 1.5, 1.0]

# Plot setup
plt.figure(figsize=(8, 6))
plt.yscale('log')
plt.ylim(0.5, 10**1.1)
plt.xlim(-1, 26)
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.title('')

# Condition 1: solid line, square markers
plt.plot(time_cond1, cfu_cond1, 'k-', marker='s', markersize=7, label='Condition 1')

# Condition 2: dashed line, triangle up markers
plt.plot(time_cond2, cfu_cond2, 'k--', marker='^', markersize=7, label='Condition 2')

# Condition 3: dotted line, circle markers
plt.plot(time_cond3, cfu_cond3, 'k:', marker='o', markersize=7, label='Condition 3')

# Condition 4: dash-dot line, diamond markers
plt.plot(time_cond4, cfu_cond4, 'k-.', marker='D', markersize=7, label='Condition 4')

# Condition 5: solid line with thicker width, filled circle markers
plt.plot(time_cond5, cfu_cond5, 'k-', marker='o', markersize=7, markerfacecolor='k', label='Condition 5')

# Axis break indication
plt.axvline(x=14, ymin=0.01, ymax=0.99, color='k', linestyle='-')
plt.plot([13.5, 14.5], [0.55, 0.55], 'k-', lw=1)
plt.plot([13.5, 14.5], [0.5, 0.5], 'k-', lw=1)

# LOD line (horizontal dashed line at y=1)
plt.hlines(1, -1, 26, colors='k', linestyles='dashed', linewidth=0.8)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FZ\FZ_png.p5.v4"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FZ_png-replot.p5.v4.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()