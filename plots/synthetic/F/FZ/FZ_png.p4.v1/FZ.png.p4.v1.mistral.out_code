import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond1 = [6.1, 7.8, 8.0, 8.1, 8.2, 8.3, 8.4, 8.5]

time_cond2 = [0, 2, 4, 6, 8, 10]
count_cond2 = [6.1, 5.9, 2.0, 2.1, 1.0, 1.1]

time_cond3 = [0, 2, 4, 6, 8, 10, 20, 24]
count_cond3 = [6.1, 2.0, 1.0, 1.3, 2.0, 2.5, 1.3, 1.3]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 20, 24]
count_cond4 = [6.1, 6.5, 8.2, 8.3, 8.6, 8.8, 9.0, 9.0, 9.0]

time_cond5 = [0, 2, 4, 6, 8, 10, 12, 22, 24]
count_cond5 = [6.1, 3.0, 2.6, 2.5, 2.3, 1.0, 2.1, 1.0, 1.0]

# Plot
plt.figure(figsize=(8, 6))
plt.plot(time_cond1, count_cond1, 's-', color='black', label='Condition 1', markersize=7)
plt.plot(time_cond2, count_cond2, '^--', color='black', label='Condition 2', markersize=7)
plt.plot(time_cond3, count_cond3, ':', color='black', marker='o', label='Condition 3', markersize=7)
plt.plot(time_cond4, count_cond4, 'D-', color='black', label='Condition 4', markersize=7)
plt.plot(time_cond5, count_cond5, 'o-', color='black', label='Condition 5', markersize=7, markerfacecolor='none')

# Axis labels and title
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.ylim(0, 10)
plt.xlim(0, 26)

# Axis break
plt.gca().set_xlim(0, 26)
plt.gca().set_ylim(0, 10)
plt.gca().spines['right'].set_visible(False)
plt.gca().spines['top'].set_visible(False)

# Customize the plot to mimic the break
plt.gca().plot((20, 20), (9.5, 10), 'k-', lw=1.5)
plt.gca().plot((22, 22), (9.5, 10), 'k-', lw=1.5)

# Legend
plt.legend(loc='upper left')

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FZ\FZ_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FZ_png-replot.p4.v1.png"), bbox_inches='tight', dpi=300)
plt.close()