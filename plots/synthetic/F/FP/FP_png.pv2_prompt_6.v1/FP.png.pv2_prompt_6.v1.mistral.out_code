import os
import matplotlib.pyplot as plt

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/F/FP\FP_png.pv2_prompt_6.v1\FP_png-replot.pv2_prompt_6.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
curves_data = [
    {
        "label": "Condition 1",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 3.5}, {"x": 4, "y": 3.1}, {"x": 6, "y": 3.1},
            {"x": 8, "y": 3.5}, {"x": 10, "y": 3.7}, {"x": 12, "y": 3.8}, {"x": 24, "y": 5}
        ],
        "marker": "s",
        "linestyle": "-",
        "color": "#000000"
    },
    {
        "label": "Condition 2",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 1.5}, {"x": 4, "y": 0.7}, {"x": 6, "y": 0.7},
            {"x": 8, "y": 0.7}, {"x": 10, "y": 0.7}, {"x": 12, "y": 0.7}, {"x": 24, "y": 0.7}
        ],
        "marker": "^",
        "linestyle": "--",
        "color": "#444444"
    },
    {
        "label": "Condition 3",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 5.9}, {"x": 4, "y": 5.9}, {"x": 6, "y": 5.9},
            {"x": 8, "y": 5.9}, {"x": 10, "y": 1.8}, {"x": 12, "y": 1.5}, {"x": 24, "y": 2}
        ],
        "marker": "o",
        "linestyle": ":",
        "color": "#666666"
    },
    {
        "label": "Condition 4",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 7.5}, {"x": 4, "y": 8.2}, {"x": 6, "y": 8.5},
            {"x": 8, "y": 8.9}, {"x": 10, "y": 8.9}, {"x": 12, "y": 9}, {"x": 24, "y": 9.2}
        ],
        "marker": "D",
        "linestyle": "-.",
        "color": "#888888"
    },
    {
        "label": "Condition 5",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 3.5}, {"x": 4, "y": 3.7}, {"x": 6, "y": 3.1},
            {"x": 8, "y": 3.2}, {"x": 10, "y": 3.3}, {"x": 12, "y": 3.5}, {"x": 24, "y": 4.8}
        ],
        "marker": "o",
