import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
count_cond1 = [6.0, 5.8, 6.8, 8.3, 8.4, 8.5, 8.6, 8.6, 8.7, 8.7, 8.7]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
count_cond2 = [6.0, 8.0, 6.3, 2.5, 2.7, 1.0, 1.5, 1.8, 2.0, 3.0, 3.7]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
count_cond3 = [6.0, 1.0, 0.8, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
count_cond4 = [6.0, 5.5, 0.8, 8.6, 8.7, 8.7, 8.8, 8.8, 8.8, 8.9, 8.9]

# Plot
plt.figure(figsize=(8, 6))
plt.plot(time_cond1, count_cond1, 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time_cond2, count_cond2, '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5)
plt.plot(time_cond3, count_cond3, 'o:', color='black', label='Condition 3', markersize=8, linewidth=1.5)
plt.plot(time_cond4, count_cond4, 'D-', color='black', label='Condition 4', markersize=8, linewidth=1.5)

# Axis labels and title
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

# Axis limits
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks(np.arange(0, 27, 2))
plt.yticks(np.arange(0, 11, 1))

# Legend
plt.legend(loc='upper right', fontsize=10)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FJ\FJ_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FJ_png-replot.p4.v1.png"), bbox_inches='tight', dpi=300)
plt.close()