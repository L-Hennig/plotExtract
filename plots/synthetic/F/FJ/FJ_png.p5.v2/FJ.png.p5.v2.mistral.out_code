import matplotlib.pyplot as plt
import numpy as np

# Data
time_cond1 = [0, 2, 4, 6, 8, 10]
log_cfu_cond1 = [6.0, 5.8, 6.8, 8.3, 8.4, 8.5]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 18, 24]
log_cfu_cond2 = [6.0, 8.0, 2.5, 2.5, 2.3, 1.0, 1.0, 1.5, 3.5]

time_cond3 = [0, 2, 4, 6, 8, 10, 12]
log_cfu_cond3 = [6.0, 1.0, 0.8, 0.7, 0.7, 0.7, 0.7]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
log_cfu_cond4 = [6.0, 7.8, 8.5, 8.7, 8.7, 8.8, 8.9, 9.1]

# Plot settings
plt.figure(figsize=(8, 6))
plt.rcParams['font.family'] = 'Arial'
plt.rcParams['font.size'] = 12

# Plot each condition
plt.plot(time_cond1, log_cfu_cond1, marker='s', linestyle='-', color='black', label='Condition 1', markersize=8)
plt.plot(time_cond2, log_cfu_cond2, marker='^', linestyle='--', color='black', label='Condition 2', markersize=8)
plt.plot(time_cond3, log_cfu_cond3, marker='o', linestyle=':', color='black', label='Condition 3', markersize=8)
plt.plot(time_cond4, log_cfu_cond4, marker='D', linestyle='-', color='black', label='Condition 4', markersize=8)

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.xticks(np.arange(0, 27, 2))
plt.yticks(np.arange(0, 11, 1))

# Log scale for y-axis
plt.yscale('log')
plt.ylim(10**0, 10**10)
plt.gca().set_yticklabels([int(x) if x.is_integer() else x for x in np.log10(plt.yticks()[0])])
plt.gca().set_yticks([10**i for i in range(0, 11)])

# Add legend
plt.legend(loc='upper left', fontsize=10)

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FJ\FJ_png.p5.v2\FJ_png-replot.p5.v2.png", bbox_inches='tight', dpi=300)
plt.close()