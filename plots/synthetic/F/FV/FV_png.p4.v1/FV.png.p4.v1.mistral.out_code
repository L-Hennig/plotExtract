import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 1, 2, 4, 6, 8, 10, 12, 24]
count_cond1 = [6.1, 7.8, 8.0, 8.2, 8.8, 9.0, 9.1, 9.1, 9.2]

time_cond2 = [0, 1, 2, 4, 6, 8, 10, 12, 24]
count_cond2 = [6.0, 7.9, 4.0, 3.5, 2.0, 2.0, 1.5, 1.3, 0.7]

time_cond3 = [0, 1, 2, 4, 6, 8, 10, 12]
count_cond3 = [6.0, 1.0, 0.8, 0.7, 1.0, 1.8, 2.0, 2.0]

time_cond4 = [0, 1, 2, 4, 6, 8, 10, 12]
count_cond4 = [6.0, 8.0, 8.1, 8.0, 8.0, 8.0, 7.9, 7.8]

time_cond5 = [0, 1, 2, 4, 6, 8, 10, 12, 24, 24]
count_cond5 = [6.0, 3.5, 3.0, 3.2, 3.3, 3.1, 7.9, 7.8, 4.8, 2.0]

time_cond6 = [0, 1, 2, 4, 6, 8, 10, 12, 24, 24]
count_cond6 = [6.0, 7.8, 2.5, 2.0, 1.5, None, 3.0, 1.0, 2.0, 1.3]

# Plot setup
plt.figure(figsize=(8, 6))
plt.yscale('log')
plt.ylim(0.1, 10)
plt.xlim(0, 26)
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Condition 1
plt.plot(time_cond1, count_cond1, 'k-s', label='Condition 1', markersize=6, linestyle='-')

# Condition 2
plt.plot(time_cond2, count_cond2, 'k^', label='Condition 2', markersize=6, linestyle='--')

# Condition 3
plt.plot(time_cond3, count_cond3, 'k:', marker='o', markerfacecolor='none', markersize=6, label='Condition 3')

# Condition 4
plt.plot(time_cond4, count_cond4, 'k--', marker='D', markerfacecolor='none', markersize=6, label='Condition 4')

# Condition 5
plt.plot(time_cond5, count_cond5, 'k-', marker='o', markersize=6, label='Condition 5')

# Condition 6
plt.plot(time_cond6[:8], count_cond6[:8], 'k-.', marker='s', markerfacecolor='none', markersize=6, label='Condition 6')
plt.plot(time_cond6[8:], count_cond6[8:], 'k-.', marker='s', markerfacecolor='none', markersize=6)

# Axis break
plt.axvline(x=16, ymin=0.05, ymax=0.95, color='k', linestyle='-')
plt.plot([15.5, 16.5], [0.1, 0.1], 'w', linewidth=2)
plt.plot([15.5, 16.5], [10, 10], 'w', linewidth=2)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FV\FV_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FV_png-replot.p4.v1.png"), bbox_inches='tight', dpi=300)
plt.close()