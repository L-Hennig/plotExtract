import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import os

# Data preparation
data = {
    'Time_1': [0, 2, 24],
    'CFU_1': [6.1, 8.9, 9.2],
    'Time_2': [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24],
    'CFU_2': [6.1, 1.3, np.nan, np.nan, np.nan, np.nan, np.nan, np.nan, np.nan, np.nan, 0.7],
    'Time_3': [0, 2, 4, 6, 8, 10, 12, 14, 24],
    'CFU_3': [6.1, 6.0, 5.9, 5.9, 5.9, np.nan, np.nan, np.nan, 5.8],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [6.1, 1.0, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7],
    'Time_5': [0, 2, 4, 6, 8, 10, 24],
    'CFU_5': [6.1, 3.0, 2.8, 2.6, 2.5, 2.3, 1.0],
    'Time_6': [0, 2, 24],
    'CFU_6': [6.1, 1.0, 0.7]
}

# Create plot
plt.figure(figsize=(8, 6))

# Condition 1: Square, solid line
plt.plot(data['Time_1'], data['CFU_1'], 's-', color='black', label='Condition 1', markersize=8)

# Condition 2: Triangle up, dashed line
plt.plot(data['Time_2'], data['CFU_2'], '^--', color='black', label='Condition 2', markersize=8)

# Condition 3: Circle, dotted line
plt.plot(data['Time_3'], data['CFU_3'], 'o:', color='black', label='Condition 3', markersize=8)

# Condition 4: Diamond, solid line with arrows
plt.plot(data['Time_4'], data['CFU_4'], 'D-', color='black', label='Condition 4', markersize=8)
plt.annotate('', xy=(2, 1.0), xytext=(1.5, 1.5), arrowprops=dict(arrowstyle='->', color='black', lw=1.5))

# Condition 5: Circle, solid line
plt.plot(data['Time_5'], data['CFU_5'], 'o-', color='black', label='Condition 5', markersize=8)

# Condition 6: Diamond, dashed line
plt.plot(data['Time_6'], data['CFU_6'], 'D--', color='black', label='Condition 6', markersize=8)

# Axis settings
plt.xlim(0, 25)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['0', '2', '4', '6', '8', '10'])
plt.xticks(np.arange(0, 26, 2))

# Grid and layout
plt.grid(False)
plt.tight_layout()

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FQ\FQ_png.p5.v3"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FQ_png-replot.p5.v3.png"), dpi=300, bbox_inches='tight')
plt.close()