import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import os

# Data preparation
data = {
    'Time_1': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_1': [6.1, 7.8, 7.9, 7.9, 7.9, 7.8, 7.7, 7.6],
    'Time_2': [0, 2, 4, 6, 8, 10, 24],
    'CFU_2': [6.1, 8.3, 8.3, 8.3, 8.3, 8.3, 8.3],
    'Time_3': [0, 2, 6, 8, 10, 12, 24],
    'CFU_3': [6.1, 1.5, 1.8, 1.9, 1.9, 2.0, 2.5],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [6.1, 1.3, 1.3, 1.3, 1.3, 1.3, 1.3, 1.3],
    'Time_5': [0, 2, 6, 8, 10, 12, 24],
    'CFU_5': [6.1, 3.0, 2.5, 2.3, 2.3, 2.3, 1.3],
    'Time_6': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_6': [6.1, 7.9, 8.2, 8.2, 8.2, 8.2, 8.2, 8.3]
}

# Plot styling
plt.figure(figsize=(8, 6))
plt.rcParams['font.family'] = 'Arial'
plt.rcParams['font.size'] = 12

# Condition 1: Square, solid line
plt.plot(data['Time_1'], data['CFU_1'], 's-', color='black', markersize=8, linewidth=1.5, label='Condition 1')

# Condition 2: Triangle up, dashed line
plt.plot(data['Time_2'], data['CFU_2'], '^--', color='black', markersize=8, linewidth=1.5, label='Condition 2', dashes=(5, 2))

# Condition 3: Dotted line, small dot markers
plt.plot(data['Time_3'], data['CFU_3'], ':', color='black', markersize=4, linewidth=1.5, marker='o', label='Condition 3')

# Condition 4: Diamond, dash-dot line
plt.plot(data['Time_4'], data['CFU_4'], 'D-.', color='black', markersize=8, linewidth=1.5, label='Condition 4', dashes=(3, 2, 1, 2))

# Condition 5: Circle, solid line
plt.plot(data['Time_5'], data['CFU_5'], 'o-', color='black', markersize=8, linewidth=1.5, label='Condition 5')

# Condition 6: Diamond (filled), dashed line
plt.plot(data['Time_6'], data['CFU_6'], '|--', color='black', markersize=10, marker='D', linewidth=1.5, label='Condition 6', dashes=(5, 2), markerfacecolor='black')

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['1', '2', '4', '6', '8', '10'])
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24])

# Axis break indication (if needed)
plt.gca().spines['bottom'].set_linewidth(1.5)
plt.gca().spines['left'].set_linewidth(1.5)

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FW\FW_png.p5.v2"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FW_png-replot.p5.v2.png"), dpi=300, bbox_inches='tight')
plt.close()