import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond1 = [6.1, 7.8, 7.9, 7.9, 7.9, 7.8, 7.7, 7.6]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond2 = [6.1, 8.1, 8.2, 8.3, 8.3, 8.3, 8.3, 8.3]

time_cond3 = [0, 2, 4, 6, 8, 10, 12]
count_cond3 = [6.1, 3.0, 2.0, 1.8, 1.7, 1.7, 1.8]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond4 = [6.1, 1.5, 1.3, 1.3, 1.3, 1.3, 1.3, 1.3]

time_cond5 = [0, 2, 4, 6, 8, 10, 12]
count_cond5 = [6.1, 2.7, 2.5, 2.3, 2.2, 2.3, 2.4]

time_cond6 = [0, 2, 4, 6, 8, 10, 12, 24]
count_cond6 = [6.1, 7.9, 8.0, 8.1, 8.1, 8.1, 8.1, 8.3]

# Plot setup
plt.figure(figsize=(8, 6))
plt.yscale('log')
plt.ylim(1, 10)
plt.xlim(0, 26)
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Plot each condition
plt.plot(time_cond1, count_cond1, color='black', linestyle='-', marker='s', label='Condition 1')
plt.plot(time_cond2, count_cond2, color='black', linestyle='--', marker='^', label='Condition 2')
plt.plot(time_cond3, count_cond3, color='black', linestyle=':', marker='o', mfc='none', label='Condition 3')
plt.plot(time_cond4, count_cond4, color='black', linestyle='-.', marker='D', label='Condition 4')
plt.plot(time_cond5, count_cond5, color='black', linestyle='-', marker='o', label='Condition 5')
plt.plot(time_cond6, count_cond6, color='black', linestyle='--', marker='d', mfc='none', label='Condition 6')

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FW\FW_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FW_png-replot.p4.v1.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()