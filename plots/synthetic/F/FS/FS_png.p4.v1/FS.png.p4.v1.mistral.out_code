import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time = np.array([0, 2, 4, 6, 8, 10, 12, 14, 24])
condition1 = np.array([6.1, 7.9, 8.6, 8.7, 8.7, 8.7, 8.7, 8.7, 8.7])
condition2 = np.array([6.0, 7.7, 8.4, 8.6, 8.5, 8.4, 8.3, 8.2, 8.3])
condition3 = np.array([6.0, 7.0, 7.5, 7.6, 7.7, 7.8, 7.8, 7.7, 7.6])
condition4 = np.array([6.0, 7.3, 7.8, 8.3, 8.2, 8.1, 8.0, 7.9, 8.1])
condition5 = np.array([6.0, 2.5, 2.7, 3.0, 2.0, 1.8, 1.7, 1.8, 1.5])
condition6 = np.array([6.0, 1.0, 1.0, 1.5, 1.3, 1.0, 1.0, 1.2, 2.5])

# Plot settings
plt.figure(figsize=(8, 6))
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.yscale('log')
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Plot each condition
plt.plot(time, condition1, 's-', color='black', label='Condition 1', markersize=8)
plt.plot(time, condition2, '^--', color='black', label='Condition 2', markersize=8)
plt.plot(time, condition3, 'o:', color='black', label='Condition 3', markersize=8)
plt.plot(time, condition4, 'D-.', color='black', label='Condition 4', markersize=8)
plt.plot(time, condition5, 'o-', color='black', label='Condition 5', markersize=8)
plt.plot(time, condition6, 'v--', color='black', label='Condition 6', markersize=8)

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FS\FS_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FS_png-replot.p4.v1.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()