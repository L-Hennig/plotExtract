    {
        "label": "Condition 2",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 7.8}, {"x": 4, "y": 8.2}, {"x": 6, "y": 8.4},
            {"x": 8, "y": 8.3}, {"x": 10, "y": 8.2}, {"x": 12, "y": 8.1}, {"x": 24, "y": 3.2}
        ],
        "marker": "^",
        "linestyle": "--",
        "color": "#333333"
    },
    {
        "label": "Condition 3",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 1.5}, {"x": 4, "y": 1.8}, {"x": 6, "y": 2.1},
            {"x": 8, "y": 2.0}, {"x": 10, "y": 1.9}, {"x": 12, "y": 2.0}, {"x": 24, "y": 2.5}
        ],
        "marker": "o",
        "linestyle": ":",
        "color": "#666666"
    },
    {
        "label": "Condition 4",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 1.2}, {"x": 4, "y": 7.8}, {"x": 6, "y": 8.1},
            {"x": 8, "y": 8.0}, {"x": 10, "y": 7.9}, {"x": 12, "y": 7.8}, {"x": 24, "y": 8.0}
        ],
        "marker": "D",
        "linestyle": "-.",
        "color": "#999999"
    },
    {
        "label": "Condition 5",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 2.8}, {"x": 4, "y": 2.9}, {"x": 6, "y": 3.0},
            {"x": 8, "y": 2.1}, {"x": 10, "y": 2.0}, {"x": 12, "y": 2.0}, {"x": 24, "y": 1.5}
