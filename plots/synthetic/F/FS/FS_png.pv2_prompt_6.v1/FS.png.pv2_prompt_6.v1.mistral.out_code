os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
curves_data = [
    {
        "label": "Condition 1",
        "points": [
            {"x": 0, "y": 6}, {"x": 2, "y": 8.3}, {"x": 4, "y": 8.5}, {"x": 6, "y": 8.7},
            {"x": 8, "y": 8.8}, {"x": 10, "y": 8.7}, {"x": 12, "y": 8.6}, {"x": 24, "y": 8.6}
