import matplotlib.pyplot as plt
import numpy as np

# Data
time = [0, 2, 4, 6, 8, 10, 12, 18, 24]
condition1 = [6.0, 5.8, 6.7, 6.8, 7.0, 8.0, 8.2, 8.2, 8.3]
condition2 = [6.0, 2.5, 1.5, 1.3, 1.7, 1.8, 1.8, 1.8, 1.9]
condition3 = [6.0, 3.8, 3.3, 3.4, 3.5, 4.0, 4.5, 5.8, 6.7]
condition4 = [6.0, 8.5, 8.8, 8.9, 8.9, 8.7, 8.6, 8.7, 8.8]

# Plot settings
plt.figure(figsize=(8, 6))
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xticks(np.arange(0, 26, 2))
plt.yticks(np.arange(0, 11, 1))

# Plot each condition
plt.plot(time, condition1, 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time, condition2, '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5)
plt.plot(time, condition3, 'o:', color='black', label='Condition 3', markersize=8, linewidth=1.5)
plt.plot(time, condition4, 'D-', color='black', label='Condition 4', markersize=8, linewidth=1.5)

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Log scale for y-axis
plt.yscale('log')

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FI\FI_png.p4.v1\FI_png-replot.p4.v1.png", bbox_inches='tight', dpi=300)
plt.close()