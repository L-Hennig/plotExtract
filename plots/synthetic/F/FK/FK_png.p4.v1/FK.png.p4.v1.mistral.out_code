import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 1, 2, 4, 6, 8, 10, 12, 24]
count_cond1 = [6.0, 7.9, 8.2, 8.4, 8.5, 8.6, 8.6, 8.6, 8.3]

time_cond2 = [0, 1, 2, 4, 6, 8, 10, 12, 24]
count_cond2 = [6.0, 1.5, 1.3, 1.0, 0.7, 0.7, 0.7, 0.7, 0.7]

time_cond3 = [0, 1, 2, 4, 6, 8]
count_cond3 = [6.0, 4.8, 2.0, 0.8, 0.7, 0.7]

time_cond4 = [0, 1, 2, 4, 6, 8, 10, 12, 24]
count_cond4 = [6.0, 7.8, 8.4, 8.6, 8.6, 8.6, 8.6, 8.7, 8.9]

# Plot
plt.figure(figsize=(8, 6))
plt.plot(time_cond1, count_cond1, 'k-s', label='Condition 1', markersize=8, linewidth=2)
plt.plot(time_cond2, count_cond2, 'k--^', label='Condition 2', markersize=8, linewidth=2)
plt.plot(time_cond3, count_cond3, 'k:o', label='Condition 3', markersize=8, linewidth=2)
plt.plot(time_cond4, count_cond4, 'k-D', label='Condition 4', markersize=8, linewidth=2)

plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.ylim(0, 10)
plt.xlim(0, 26)
plt.xticks(np.arange(0, 27, 2))
plt.yticks(np.arange(0, 11, 1))
plt.grid(False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FK\FK_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FK_png-replot.p4.v1.png"), bbox_inches='tight', dpi=300)
plt.close()