import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond1 = [6.0, 8.0, 8.5, 8.6, 8.6, 8.6, 8.6, 8.3]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond2 = [6.0, 1.5, 1.0, 0.7, 0.7, 0.7, 0.7, 0.7]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond3 = [6.0, 2.0, 1.0, 0.7, 0.7, 0.7, 0.7, 0.7]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond4 = [6.0, 8.3, 8.5, 8.6, 8.6, 8.6, 8.6, 8.9]

# Create plot
plt.figure(figsize=(8, 6))
plt.plot(time_cond1, cfu_cond1, 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time_cond2, cfu_cond2, '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5, dashes=(5, 2))
plt.plot(time_cond3, cfu_cond3, 'o:', color='black', label='Condition 3', markersize=8, linewidth=1.5)
plt.plot(time_cond4, cfu_cond4, 'D-', color='black', label='Condition 4', markersize=8, linewidth=1.5)

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.xticks(np.arange(0, 27, 2), fontsize=10)
plt.yticks(np.arange(0, 11, 1), fontsize=10)
plt.yscale('log')
plt.grid(False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FK\FK_png.p5.v3"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FK_png-replot.p5.v3.png"), dpi=300, bbox_inches='tight')
plt.close()