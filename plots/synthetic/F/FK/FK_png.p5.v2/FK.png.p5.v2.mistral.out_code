import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Data preparation
data = {
    'Time_1': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_1': [6.0, 8.0, 8.5, 8.6, 8.6, 8.6, 8.6, 8.3],
    'Time_2': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_2': [6.0, 1.5, 1.0, 0.7, 0.7, 0.7, 0.7, 0.7],
    'Time_3': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_3': [6.0, 2.0, 1.0, 0.7, 0.7, 0.7, 0.7, 0.7],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [6.0, 8.3, 8.5, 8.6, 8.6, 8.6, 8.6, 8.9]
}

# Create plot
plt.figure(figsize=(8, 6))
plt.rcParams['font.family'] = 'Arial'
plt.rcParams['font.size'] = 12

# Plot Condition 1
plt.plot(data['Time_1'], data['CFU_1'], color='black', linestyle='-', marker='s', markersize=8, label='Condition 1')

# Plot Condition 2
plt.plot(data['Time_2'], data['CFU_2'], color='black', linestyle='--', marker='^', markersize=8, label='Condition 2')

# Plot Condition 3
plt.plot(data['Time_3'], data['CFU_3'], color='black', linestyle=':', marker='o', markersize=8, label='Condition 3')

# Plot Condition 4
plt.plot(data['Time_4'], data['CFU_4'], color='black', linestyle='-', marker='D', markersize=8, label='Condition 4')

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['1', '2', '4', '6', '8', '10'])
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24])

# Grid and legend
plt.grid(True, which="both", ls="--", c='0.8')
plt.legend(loc='upper right', frameon=False)

# Save plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FK\FK_png.p5.v2\FK_png-replot.p5.v2.png", dpi=300, bbox_inches='tight')
plt.close()