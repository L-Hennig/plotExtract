import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 1, 2, 4, 6, 8, 10]
count_cond1 = [6.0, 4.0, 2.5, 2.3, 2.1, 2.0, 1.8]

time_cond2 = [0, 1, 2, 4, 6, 8, 10, 12, 14, 16, 20, 22, 24]
count_cond2 = [6.1, 3.0, 2.0, 2.2, 2.8, 3.0, np.nan, 1.5, 1.8, 2.0, 2.5, 3.0, 8.3]

time_cond3 = [0, 1, 2, 4, 6, 8, 10, 12, 14, 16]
count_cond3 = [6.0, 1.0, 0.8, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7]

time_cond4 = [0, 1, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
count_cond4 = [8.0, 8.5, 8.6, 8.7, 8.6, 8.5, 8.4, 8.5, 8.5, 8.5, 8.6, 8.2]

time_cond5 = [0, 1, 2, 4, 6, 8, 10, 12, 14, 16, 20]
count_cond5 = [6.2, 2.5, 2.3, 2.0, 2.0, 2.1, 2.0, 1.8, 1.5, 1.3, 1.0]

time_cond6 = [0, 1, 2, 6, 10, 22, 24]
count_cond6 = [6.0, 0.5, 0.7, 1.0, 1.0, 0.8, 0.7]

# Plot
plt.figure(figsize=(8, 6))

# Condition 1
plt.plot(time_cond1, count_cond1, linestyle='-', color='black', marker='s', label='Condition 1')

# Condition 2
plt.plot(time_cond2, count_cond2, linestyle='--', color='black', marker='^', label='Condition 2')

# Condition 3
plt.plot(time_cond3, count_cond3, linestyle=':', color='black', marker='o', label='Condition 3')

# Condition 4
plt.plot(time_cond4, count_cond4, linestyle='-.', color='black', marker='D', label='Condition 4')

# Condition 5
plt.plot(time_cond5, count_cond5, linestyle='-', color='black', marker='o', mfc='white', label='Condition 5')

# Condition 6
plt.plot(time_cond6, count_cond6, linestyle='--', color='black', marker='>', mfc='white', label='Condition 6')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Axis range
plt.xlim(0, 26)
plt.ylim(0, 10)

# Grid and legend
plt.grid(False)
plt.legend()

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FO\FO_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FO_png-replot.p4.v1.png"), dpi=300, bbox_inches='tight')
plt.close()