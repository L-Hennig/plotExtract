import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond1 = [6.5, 6.7, 7.0, 7.8, 8.2, 8.4, 8.5, 8.6]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond2 = [6.0, 6.1, 6.0, 6.0, 6.0, 6.0, 6.0, 6.0]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond3 = [5.5, 0.8, 0.7, 1.0, 2.2, 1.3, 0.8, 2.0]

# Plot settings
plt.figure(figsize=(6, 5))
plt.rcParams['font.family'] = 'sans-serif'
plt.rcParams['font.size'] = 12

# Plot Condition 1
plt.plot(time_cond1, cfu_cond1, color='black', linestyle='-', marker='s', markersize=6, label='Condition 1')

# Plot Condition 2
plt.plot(time_cond2, cfu_cond2, color='black', linestyle='--', marker='^', markersize=6, label='Condition 2')

# Plot Condition 3
plt.plot(time_cond3, cfu_cond3, color='black', linestyle=':', marker='o', markersize=6, fillstyle='none', label='Condition 3')

# Axis settings
plt.xlim(0, 26)
plt.ylim(0.5, 10)
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['1', '2', '4', '6', '8', '10'])

# Legend
plt.legend(loc='upper right', frameon=False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FB\FB_png.p5.v3"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FB_png-replot.p5.v3.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()