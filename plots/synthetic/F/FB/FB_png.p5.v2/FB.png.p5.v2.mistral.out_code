import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu1 = [6.5, 6.7, 7.0, 7.8, 8.2, 8.4, 8.5, 8.6]

time2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu2 = [6.0, 6.1, 5.9, 6.0, 5.9, 6.0, 6.0, 6.1]

time3 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu3 = [5.5, 0.8, 0.7, 1.0, 2.3, 1.5, 0.8, 2.0]

# Create plot
plt.figure(figsize=(6, 5))
plt.plot(time1, cfu1, 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time2, cfu2, '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5, markerfacecolor='none')
plt.plot(time3, cfu3, 'o:', color='black', label='Condition 3', markersize=8, linewidth=1.5, markerfacecolor='none')

# Axis labels and limits
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks(np.arange(0, 27, 2), fontsize=10)
plt.yticks(np.arange(0, 11, 1), fontsize=10)

# Log scale
plt.yscale('log')

# Grid
plt.grid(True, which="both", ls="--", alpha=0.5)

# Legend
plt.legend(loc='upper right', fontsize=10, frameon=False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FB\FB_png.p5.v2"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "FB_png-replot.p5.v2.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()