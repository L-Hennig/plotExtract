import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond1 = [7.8, 8.3, 8.4, 8.5, 8.3, 8.3, 8.2, 7.9]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 14, 24]
cfu_cond2 = [6.1, 6.3, 5.7, 6.8, 6.7, 6.0, 5.7, 5.6, 5.8]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 14, 24]
cfu_cond3 = [1.2, 1.0, 1.0, 1.0, 1.1, 1.3, 1.4, 1.7, 3.2]

# Create plot
plt.figure(figsize=(6, 5))
plt.plot(time_cond1, cfu_cond1, 's-', color='black', label='Condition 1', markersize=7, linewidth=1.5)
plt.plot(time_cond2, cfu_cond2, '^--', color='black', label='Condition 2', markersize=7, linewidth=1.5, markerfacecolor='none')
plt.plot(time_cond3, cfu_cond3, 'o:', color='black', label='Condition 3', markersize=7, linewidth=1.5, markerfacecolor='none')

# Axis settings
plt.xlim(0, 25)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['0', '2', '4', '6', '8', '10'])
plt.xticks(np.arange(0, 26, 2))

# Legend
plt.legend(loc='upper right', fontsize=10, frameon=False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FD\FD_png.p5.v3"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FD_png-replot.p5.v3.png"), dpi=300, bbox_inches='tight')
plt.close()