import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 24]
count_cond1 = [7.8, 8.3, 8.4, 8.6, 8.5, 8.4, 8.3, 8.2, 8.1, 7.9]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
count_cond2 = [6.0, 6.2, 5.7, 6.7, 6.8, 6.6, 5.9, 5.7, 5.6, 5.6, 5.7]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24]
count_cond3 = [5.8, 1.0, 0.9, 0.8, 1.0, 1.3, 1.1, 1.7, 2.0, 2.5, 3.2]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time_cond1, count_cond1, 'k-s', label='Condition 1', markersize=8, linewidth=2)
plt.plot(time_cond2, count_cond2, 'k--^', label='Condition 2', markersize=8, linewidth=2)
plt.plot(time_cond3, count_cond3, 'k:o', label='Condition 3', markersize=8, linewidth=2)

# Axis labels
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

# Axis limits
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks(np.arange(0, 27, 2))
plt.yticks(np.arange(0, 11, 1))

# Legend
plt.legend(loc='upper right', fontsize=10)

# Grid
plt.grid(False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\F\FD\FD_png.p4.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "FD_png-replot.p4.v1.png"), dpi=300, bbox_inches='tight')
plt.close()