import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Data preparation
data = {
    'Time_C1': [0, 2, 4, 6, 8, 10, 12, 20],
    'CFU_C1': [4.6, 6.8, 5.3, 4.5, 4.0, 3.8, 3.5, 4.0],
    'Time_C2': [0, 2, 4, 6, 8, 10, 12, 16, 20],
    'CFU_C2': [5.8, 5.9, 5.6, 5.3, 4.9, 4.5, 4.0, 3.6, 3.2],
    'Time_C3': [0, 2, 4, 6, 8, 10, 12, 16, 20],
    'CFU_C3': [6.2, 6.5, 6.7, 7.0, 7.3, 7.5, 7.7, 7.8, 8.0]
}

# Create figure and axis
plt.figure(figsize=(6, 5))
ax = plt.gca()

# Plot Condition 1
ax.plot(data['Time_C1'], data['CFU_C1'], color='#1f77b4', linestyle='-', marker='o', markersize=6, label='Condition 1')
# Plot Condition 2
ax.plot(data['Time_C2'], data['CFU_C2'], color='#ff7f0e', linestyle='-', marker='o', markersize=6, label='Condition 2')
# Plot Condition 3
ax.plot(data['Time_C3'], data['CFU_C3'], color='#2ca02c', linestyle='-', marker='o', markersize=6, label='Condition 3')

# Set axis labels and title
ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacteria Count (CFU/mL)', fontsize=12)

# Set axis limits
ax.set_xlim(0, 22)
ax.set_ylim(0, 8.5)

# Set ticks
ax.set_xticks(np.arange(0, 25, 5))
ax.set_yticks(np.arange(0, 9, 2))

# Add legend
ax.legend(loc='upper left', fontsize=10, frameon=True)

# Set grid
ax.grid(True, linestyle='--', alpha=0.6)

# Save the plot
plt.tight_layout()
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CG\CG_png.p5.v1\CG_png-replot.p5.v1.png", dpi=300)
plt.close()