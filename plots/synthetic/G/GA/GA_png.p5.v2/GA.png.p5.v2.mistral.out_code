import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond1 = [6.2, 6.8, 7.2, 8.0, 8.3, 8.4, 8.4, 8.3]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond2 = [5.8, 5.9, 6.1, 6.2, 6.1, 6.3, 6.5, 5.8]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond3 = [6.0, 4.8, 2.3, 1.8, 1.6, 1.5, 1.3, 1.1]

# Create plot
plt.figure(figsize=(6, 5))
plt.plot(time_cond1, cfu_cond1, 's-', color='black', label='Condition 1', markersize=8, linewidth=1.5)
plt.plot(time_cond2, cfu_cond2, '^--', color='black', label='Condition 2', markersize=8, linewidth=1.5, markerfacecolor='none')
plt.plot(time_cond3, cfu_cond3, 'o:', color='black', label='Condition 3', markersize=8, linewidth=1.5, markerfacecolor='none')

# Axis labels and limits
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks(np.arange(0, 27, 2), fontsize=10)
plt.yticks(np.arange(0, 11, 1), fontsize=10)

# Log scale
plt.yscale('log')

# Grid
plt.grid(False)

# Legend
plt.legend(loc='upper right', fontsize=10, frameon=False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\G\GA\GA_png.p5.v2"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "GA_png-replot.p5.v2.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()