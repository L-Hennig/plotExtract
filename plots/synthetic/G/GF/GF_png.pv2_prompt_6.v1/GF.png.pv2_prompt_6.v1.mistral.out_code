import matplotlib.pyplot as plt
import os

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/G/GF\GF_png.pv2_prompt_6.v1\GF_png-replot.pv2_prompt_6.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data points extracted from the plot
marker_facts = {
    "curves": [
        {
            "label": "Condition 1",
            "marker": "s",
            "line": "-",
            "color": "#000000",
            "points": [
