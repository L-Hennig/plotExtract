        },
        {
            "label": "Condition 5",
            "marker": "v",
            "line": ":",
            "color": "#000000",
            "points": [
                (0, 6.0),
                (2, 2.0),
                (4, 1.0),
                (6, 0.5),
                (8, 0.5),
