            "line": "--",
            "color": "#000000",
            "points": [
                (0, 6.0),
                (2, 8.0),
                (4, 7.5),
                (6, 7.5),
                (8, 7.5),
                (10, 7.5),
                (12, 7.0),
                (24, 7.5)
            ]
        },
        {
            "label": "Condition 3",
            "marker": "o",
            "line": ":",
            "color": "#000000",
            "points": [
                (0, 6.0),
                (2, 6.0),
                (4, 6.5),
                (6, 6.5),
                (8, 6.5),
                (10, 7.0),
                (12, 7.0),
                (24, 8.5)
            ]
        },
        {
            "label": "Condition 4",
            "marker": "o",
            "line": "-",
            "color": "#4c4c4c",
            "points": [
                (0, 6.0),
                (2, 1.5),
                (4, 1.5),
                (6, 1.5),
                (8, 1.5),
                (10, 2.0),
