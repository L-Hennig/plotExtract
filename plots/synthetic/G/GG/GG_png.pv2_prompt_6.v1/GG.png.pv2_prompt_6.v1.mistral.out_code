            {"x": 8, "y": 8.6}, {"x": 10, "y": 8.5}, {"x": 12, "y": 8.2}, {"x": 24, "y": 8.2}
        ],
        "marker": "^",
        "linestyle": "--",
        "color": "#000000"
    },
    {
        "label": "Condition 3",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 6.8}, {"x": 4, "y": 7.0}, {"x": 6, "y": 7.3},
            {"x": 8, "y": 7.8}, {"x": 10, "y": 8.0}, {"x": 12, "y": 8.0}, {"x": 24, "y": 2.0}
        ],
        "marker": "o",
        "linestyle": ":",
        "color": "#000000"
    },
    {
        "label": "Condition 4",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 1.0}, {"x": 4, "y": 1.0}, {"x": 6, "y": 1.0},
            {"x": 8, "y": 1.0}, {"x": 10, "y": 1.0}, {"x": 12, "y": 1.0}, {"x": 24, "y": 2.0}
        ],
        "marker": "o",
        "linestyle": "-",
        "color": "#666666"
    },
    {
        "label": "Condition 5",
        "points": [
            {"x": 0, "y": 6.0}, {"x": 2, "y": 1.0}, {"x": 4, "y": 1.0}, {"x": 6, "y": 2.5},
            {"x": 8, "y": 2.0}, {"x": 10, "y": 2.0}, {"x": 12, "y": 2.0}, {"x": 24, "y": 1.5}
