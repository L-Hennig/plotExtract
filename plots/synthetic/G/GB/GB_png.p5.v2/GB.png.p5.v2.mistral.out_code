import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond1 = [6.1, 7.0, 8.7, 8.9, 8.8, 8.9, 9.1, 9.3]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond2 = [6.0, 4.8, 4.9, 4.9, 5.2, 5.3, 5.3, 5.3]

time_cond3 = [0, 4, 8, 10, 12, 24]
cfu_cond3 = [6.0, 0.7, 1.7, 1.3, 1.3, 2.0]

time_cond4 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_cond4 = [6.0, 1.0, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7]

# Plot settings
plt.figure(figsize=(8, 6))
plt.rcParams['font.family'] = 'Arial'
plt.rcParams['font.size'] = 12

# Plot each condition
plt.plot(time_cond1, cfu_cond1, marker='s', linestyle='-', color='black', label='Condition 1', markersize=8)
plt.plot(time_cond2, cfu_cond2, marker='^', linestyle='--', color='black', label='Condition 2', markersize=8)
plt.plot(time_cond3, cfu_cond3, marker='o', linestyle=':', color='black', label='Condition 3', markersize=8)
plt.plot(time_cond4, cfu_cond4, marker='o', linestyle='-', color='black', label='Condition 4', markersize=8, fillstyle='none')

# Axis settings
plt.xlim(0, 26)
plt.ylim(0.5, 10)
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['1', '2', '4', '6', '8', '10'], fontsize=12)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24], fontsize=12)

# Legend
plt.legend(loc='upper left', fontsize=10)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\G\GB\GB_png.p5.v2"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "GB_png-replot.p5.v2.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()