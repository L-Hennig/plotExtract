import matplotlib.pyplot as plt
import pandas as pd
import numpy as np
import os

# Data preparation
data = {
    'Time_1': [0, 2, 6, 8, 10, 24],
    'CFU_1': [6.1, 7.0, 8.8, 8.7, 8.8, 9.2],
    'Time_2': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_2': [6.0, 4.9, 4.8, 4.9, 5.2, 5.3, 5.3, 5.4],
    'Time_3': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_3': [6.0, 5.0, 4.0, 1.0, 2.3, 1.7, 1.3, 2.0],
    'Time_4': [0, 2, 4, 6, 8, 10, 12, 24],
    'CFU_4': [6.0, 1.0, 0.3, 0.3, 0.3, 0.3, 0.3, 0.3]
}

# Create plot
plt.figure(figsize=(6, 5))
plt.rcParams['font.size'] = 12
plt.rcParams['axes.linewidth'] = 1.5

# Plot Condition 1
plt.plot(data['Time_1'], data['CFU_1'], color='black', linestyle='-', marker='s', markersize=8, linewidth=2, label='Condition 1')

# Plot Condition 2
plt.plot(data['Time_2'], data['CFU_2'], color='black', linestyle='--', marker='^', markersize=8, linewidth=2, label='Condition 2')

# Plot Condition 3
plt.plot(data['Time_3'], data['CFU_3'], color='black', linestyle=':', marker='o', markersize=8, linewidth=2, label='Condition 3')

# Plot Condition 4
plt.plot(data['Time_4'], data['CFU_4'], color='black', linestyle='-', marker='o', markersize=8, linewidth=2, fillstyle='none', label='Condition 4')

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xlabel('Time (hours)', fontsize=12, fontweight='bold')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12, fontweight='bold')
plt.yscale('log')
plt.yticks([1, 2, 4, 6, 8, 10], ['1', '2', '4', '6', '8', '10'])
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24])

# Legend
plt.legend(loc='upper left', frameon=False, numpoints=1)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\G\GB\GB_png.p5.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "GB_png-replot.p5.v1.png"), dpi=300, bbox_inches='tight')
plt.close()