import matplotlib.pyplot as plt
import pandas as pd
import os

data = {
    'Time (hours)': [0, 2, 4, 6, 8, 10, 12, 14],
    'Bacteria Count (CFU/mL) (Condition 1)': [6, 5.8, 6, 5.9, 6, 5.7, 6.1, 6],
    'Bacteria Count (CFU/mL) (Condition 2)': [6, 6.1, 6.1, 6.2, 6.4, 6.5, 6.6, 6.7],
    'Bacteria Count (CFU/mL) (Condition 3)': [6, 6, 5.9, 5.9, 6, 6, 5.9, 5.8]
}

df = pd.DataFrame(data)

plt.figure(figsize=(8, 5))

plt.plot(df['Time (hours)'], df['Bacteria Count (CFU/mL) (Condition 1)'],
         marker='o', color='#1f77b4', label='Condition 1', linestyle='-')
plt.plot(df['Time (hours)'], df['Bacteria Count (CFU/mL) (Condition 2)'],
         marker='o', color='#ff7f0e', label='Condition 2', linestyle='-')
plt.plot(df['Time (hours)'], df['Bacteria Count (CFU/mL) (Condition 3)'],
         marker='o', color='#2ca02c', label='Condition 3', linestyle='-')

plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.ylim(0, 7)
plt.xlim(0, 14)
plt.xticks(range(0, 15, 2))
plt.yticks(range(0, 8, 1))
plt.legend()
plt.grid(False)

output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CA\CA_png.p3.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "CA_png-replot.p3.v1.png"), bbox_inches='tight', dpi=300)
plt.close()