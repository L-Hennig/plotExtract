import matplotlib.pyplot as plt
import numpy as np

# Data points from the extracted facts
time_condition1 = [0, 2, 4, 6, 8, 10, 12, 20, 22, 24]
bacterial_count_condition1 = [6, 7, 6.8, 7.5, 7.8, 8, 8.2, 2.5, 2.8, 3.5]

time_condition2 = [0, 2, 4, 6, 8, 10, 12, 20, 22, 24]
bacterial_count_condition2 = [6, 4.5, 3.8, 3.2, 2.8, 2.5, 2.3, 3.2, 3.5, 3.7]

# Create the plot
fig, ax = plt.subplots()

# Plot Condition 1
ax.plot(time_condition1[:7], bacterial_count_condition1[:7], 'o-', color='black', label='Condition 1')
ax.plot(time_condition1[7:], bacterial_count_condition1[7:], 'o-', color='black')

# Plot Condition 2
ax.plot(time_condition2[:7], bacterial_count_condition2[:7], 'o-', color='gray', label='Condition 2')
ax.plot(time_condition2[7:], bacterial_count_condition2[7:], 'o-', color='gray')

# Axis break
ax.annotate('', xy=(12.5, 0), xycoords='data', xytext=(12.5, 2.2), arrowprops=dict(arrowstyle='-', linestyle='--'))
ax.annotate('', xy=(12.5, 8.5), xycoords='data', xytext=(12.5, 6.5), arrowprops=dict(arrowstyle='-', linestyle='--'))

# Set axis labels and limits
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')
ax.set_xlim(0, 26)
ax.set_ylim(0, 9)

# Set ticks
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_yticks([0, 2, 4, 6, 8])

# Add legend
ax.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/D/DE/DE_png.pv2_prompt_4.v1/DE_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)