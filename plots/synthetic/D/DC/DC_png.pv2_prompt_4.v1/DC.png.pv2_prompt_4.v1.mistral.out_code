import matplotlib.pyplot as plt
import numpy as np

# Data points from the provided facts
curve1_points = [(0, 6.11), (2, 6.70), (4, 7.30), (6, 7.70), (8, 7.85), (10, 7.90), (24, 9.00)]
curve2_points = [(0, 6.11), (2, 4.85), (4, 3.70), (6, 2.70), (8, 2.48), (10, 2.70), (24, 3.60)]

# Separate x and y values for each curve
x1, y1 = zip(*curve1_points)
x2, y2 = zip(*curve2_points)

# Create the plot
fig, ax = plt.subplots()

# Plot each curve with specified styles
ax.plot(x1, y1, 'o-', color='black', label='Condition 1', markersize=6)
ax.plot(x2, y2, 'v-', color='black', label='Condition 2', markersize=6)

# Add axis break
ax.annotate('', xy=(11, 2), xycoords='data', xytext=(11, 7.5), textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black', shrinkA=0, shrinkB=0))
ax.annotate('', xy=(11.5, 2), xycoords='data', xytext=(11.5, 7.5), textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black', shrinkA=0, shrinkB=0))

# Set axis labels and limits
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')
ax.set_xlim(0, 25)
ax.set_ylim(0, 10)

# Set ticks
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_yticks([0, 2, 4, 6, 8, 10])

# Add legend
ax.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/D/DC\DC_png.pv2_prompt_4.v1\DC_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)