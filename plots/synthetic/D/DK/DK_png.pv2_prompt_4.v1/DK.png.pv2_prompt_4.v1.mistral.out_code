import matplotlib.pyplot as plt
import numpy as np

# Data points extracted from the image
time_points = {
    'Condition 1': [0, 2, 4, 6, 8, 10, 12, 20, 24],
    'Condition 2': [0, 2, 4, 6, 8, 10, 12, 20, 24],
    'Condition 3': [0, 2, 4, 6, 8, 10, 12, 20, 24],
    'Condition 4': [0, 2, 4, 6, 8, 10, 24]
}

bacterial_counts = {
    'Condition 1': [6, 7, 7, 7.5, 8, 8, 8, 9, 9],
    'Condition 2': [6, 5, 4, 3.5, 3, 2.5, 2.5, 3, 3.5],
    'Condition 3': [6, 3, 0, 0, 0, 0, 0, 0, 0],
    'Condition 4': [6, 4.5, 3.5, 0, 0, 0, 0]
}

# Plot styling
markers = {
    'Condition 1': 'o',
    'Condition 2': '^',
    'Condition 3': 's',
    'Condition 4': 'v'
}

colors = {
    'Condition 1': 'black',
    'Condition 2': 'black',
    'Condition 3': 'black',
    'Condition 4': 'black'
}

linestyles = {
    'Condition 1': '-',
    'Condition 2': '-',
    'Condition 3': '-',
    'Condition 4': '-'
}

# Create the plot
fig, ax = plt.subplots()

# Plot each condition
for condition in time_points:
    ax.plot(time_points[condition], bacterial_counts[condition],
            marker=markers[condition],
            color=colors[condition],
            linestyle=linestyles[condition],
            label=condition)

# Axis break indication
ax.plot([12.5, 12.5], [0, 10], color='black', linestyle='-')
ax.plot([13, 13], [0, 10], color='white', linestyle='-', linewidth=5)  # Masking the break
ax.plot([12.5, 13.5], [0, 0], color='black', linestyle='-')
ax.plot([12.5, 13.5], [10, 10], color='black', linestyle='-')

# Axis labels and limits
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')
ax.set_xlim(0, 26)
ax.set_ylim(0, 10)

# Ticks
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_yticks([0, 2, 4, 6, 8, 10])

# Legend
ax.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\D\DK\DK_png.pv2_prompt_4.v1\DK_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)