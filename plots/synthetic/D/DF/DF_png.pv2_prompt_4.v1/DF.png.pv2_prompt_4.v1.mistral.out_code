import matplotlib.pyplot as plt
import numpy as np

# Data points from the provided facts
curve1_points = [(0, 6.11), (2, 6.60), (4, 7.08), (6, 7.60), (8, 7.88), (10, 7.95), (24, 9.08)]
curve2_points = [(0, 6.11), (2, 4.30), (4, 3.60), (6, 3.00), (8, 2.70), (10, 2.78), (24, 3.48)]

# Separate x and y values for each curve
x1, y1 = zip(*curve1_points)
x2, y2 = zip(*curve2_points)

# Create the plot
fig, ax = plt.subplots(figsize=(6, 5))

# Plot each curve with specified styles
ax.plot(x1, y1, 'o-', color='black', label='Condition 1', markersize=6)
ax.plot(x2, y2, 'x-', color='black', label='Condition 2', markersize=6)

# Axis break details
ax.set_xlim(0, 25)
ax.set_ylim(0, 10)

# Add axis break indicators
ax.plot([11, 11.5], [0, 10], color='black', linewidth=1.5)  # Vertical line for break
ax.plot([11, 12], [0, 0], color='white', linewidth=3)  # Mask part of the axis
ax.plot([11, 12], [10, 10], color='white', linewidth=3)  # Mask part of the axis

# Set ticks and labels
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_yticks([0, 2, 4, 6, 8, 10])
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Add legend
ax.legend(loc='upper left')

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\D\DF\DF_png.pv2_prompt_4.v1\DF_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)