import matplotlib.pyplot as plt
import numpy as np

# Data points extracted from the plot
time_points = [0, 2, 4, 6, 8, 10, 12, 24]

# Condition 1 data (log10 CFU/mL)
condition_1 = [6.0, 6.8, 7.8, 8.1, 8.3, 8.5, 8.7, 9.2]

# Condition 2 data (log10 CFU/mL)
condition_2 = [5.8, 4.8, 4.0, 3.5, 3.0, 2.8, 2.9, 3.6]

# Create the plot
fig, ax = plt.subplots(figsize=(6, 5))

# Plot Condition 1
ax.plot(time_points, condition_1,
        color='black',
        marker='o',
        linestyle='-',
        label='Condition 1')

# Plot Condition 2
ax.plot(time_points, condition_2,
        color='black',
        marker='s',
        linestyle='-',
        label='Condition 2')

# Axis break indication
ax.annotate('', xy=(12.5, 2), xycoords='data', xytext=(12.5, 3.5), textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black'))
ax.annotate('', xy=(12.5, 9.5), xycoords='data', xytext=(12.5, 8), textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black'))

# Set axis limits and ticks
ax.set_xlim(0, 26)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_ylim(2, 10)
ax.set_yticks([2, 3, 4, 5, 6, 7, 8, 9, 10])

# Axis labels
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Legend
ax.legend(loc='upper left')

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\D\DA\DA_png.pv2_prompt_4.v1\DA_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)
plt.close()