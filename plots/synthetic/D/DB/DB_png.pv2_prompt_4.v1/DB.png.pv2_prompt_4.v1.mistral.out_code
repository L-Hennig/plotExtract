import matplotlib.pyplot as plt
import numpy as np

# Data points from the provided facts
curve1_points = [(0, 6.1), (2, 6.8), (4, 7.2), (6, 7.5), (8, 7.7), (10, 7.8), (24, 8.9)]
curve2_points = [(0, 5.9), (2, 4.8), (4, 3.9), (6, 3.0), (8, 2.5), (10, 2.3), (12, 2.4), (24, 3.8)]

# Separate x and y values for each curve
x1, y1 = zip(*curve1_points)
x2, y2 = zip(*curve2_points)

# Create the plot
fig, ax = plt.subplots()

# Plot each curve with specified styles
ax.plot(x1, y1, 'o-', color='black', label='Condition 1', markersize=6)
ax.plot(x2, y2, '^-', color='black', label='Condition 2', markersize=6)

# Axis break details
ax.set_xlim(0, 26)
ax.set_ylim(0, 9.5)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_yticks([0, 2, 4, 6, 8])

# Axis labels
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Add axis break
ax.annotate('', xy=(10.5, 0), xytext=(11.5, 0), xycoords='data', textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black'))
ax.annotate('', xy=(10.5, 9.5), xytext=(11.5, 9.5), xycoords='data', textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black'))

# Legend
ax.legend(loc='upper left')

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/D/DB\DB_png.pv2_prompt_4.v1\DB_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)