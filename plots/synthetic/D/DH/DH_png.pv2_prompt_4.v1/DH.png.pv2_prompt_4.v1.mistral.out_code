import matplotlib.pyplot as plt
import numpy as np

# Data points from the extracted facts
time_condition1 = [0, 2, 4, 6, 8, 10, 20, 24]
bacterial_count_condition1 = [6.3, 6.7, 7.3, 7.8, 7.9, 8.0, 8.3, 8.5]

time_condition2 = [0, 2, 4, 6, 8, 10, 20, 24]
bacterial_count_condition2 = [6.2, 4.5, 3.8, 3.0, 2.5, 2.7, 3.5, 3.6]

# Create the plot
fig, ax = plt.subplots()

# Plot Condition 1
ax.plot(time_condition1, bacterial_count_condition1, marker='o', color='black', label='Condition 1')

# Plot Condition 2
ax.plot(time_condition2, bacterial_count_condition2, marker='^', color='black', label='Condition 2')

# Axis break indication
ax.annotate('', xy=(11, 0), xycoords='data', xytext=(11, 1.5), textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black'))
ax.annotate('', xy=(11, 8.5), xycoords='data', xytext=(11, 7.0), textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black'))

# Set axis labels and limits
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')
ax.set_xlim(0, 26)
ax.set_ylim(0, 9)

# Set ticks
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_yticks([0, 2, 4, 6, 8])

# Add legend
ax.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/D/DH\DH_png.pv2_prompt_4.v1\DH_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)

# Do not display the plot
plt.close()