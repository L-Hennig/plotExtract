import matplotlib.pyplot as plt
import numpy as np

# Data points extracted from the image
curves = [
    {
        "label": "Condition 1",
        "points": [(0, 6.2), (2, 5.8), (4, 3.5), (6, 2.5), (8, 2.8), (10, 7.8), (12, 8.0), (24, 8.5)],
        "marker": "o",
        "color": "#000000",
        "linestyle": "-"
    },
    {
        "label": "Condition 2",
        "points": [(0, 6.2), (2, 5.5), (4, 3.0), (6, 2.0), (8, 2.5), (10, 7.9), (12, 8.1), (24, 9.2)],
        "marker": "^",
        "color": "#000000",
        "linestyle": "-"
    },
    {
        "label": "Condition 3",
        "points": [(0, 6.2), (2, 4.0), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0), (12, 0.0), (24, 0.0)],
        "marker": "s",
        "color": "#000000",
        "linestyle": "-"
    },
    {
        "label": "Condition 4",
        "points": [(0, 6.2), (2, 4.5), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0), (12, 0.0), (24, 0.0)],
        "marker": "x",
        "color": "#000000",
        "linestyle": "-"
    },
    {
        "label": "Condition 5",
        "points": [(0, 6.2), (2, 5.0), (4, 3.0), (6, 2.3), (8, 2.7), (10, 3.0), (12, 3.2), (24, 3.5)],
        "marker": "d",
        "color": "#000000",
        "linestyle": "-"
    }
]

# Create the plot
fig, ax = plt.subplots(figsize=(8, 6))

# Plot each curve
for curve in curves:
    x_vals, y_vals = zip(*curve["points"])
    ax.plot(x_vals, y_vals,
            marker=curve["marker"],
            color=curve["color"],
            linestyle=curve["linestyle"],
            label=curve["label"])

# Axis break indication
ax.plot([12.5, 12.5], [0, 10], color='black', linewidth=1.5)
ax.plot([13, 13], [0, 10], color='white', linewidth=4, solid_capstyle='butt')
ax.plot([12.5, 13.5], [0, 0], color='black', linewidth=1.5, linestyle='--')
ax.plot([12.5, 13.5], [10, 10], color='black', linewidth=1.5, linestyle='--')

# Set axis labels and limits
ax.set_xlabel("Time (hours)", fontsize=12)
ax.set_ylabel("Bacterial Count (CFU/mL) (log10 scale)", fontsize=12)
ax.set_xlim(0, 26)
ax.set_ylim(0, 10)

# Set ticks
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_yticks([0, 2, 4, 6, 8, 10])

# Add legend
ax.legend(loc='upper left', fontsize=10)

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/D/DL/DL_png.pv2_prompt_4.v1/DL_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)