import matplotlib.pyplot as plt

# Data
time_hours = [0, 1, 2, 4, 6, 7, 8, 10, 12, 14]
bacteria_count = [6.9, 6.8, 6.8, 6.7, 4.1, 6.8, 6.8, 6.9, 7.5, 6.9]

# Plot settings
plt.figure(figsize=(6, 4))
plt.plot(time_hours, bacteria_count, marker='o', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')

# Axis ranges
plt.xlim(0, 15)
plt.ylim(0, 8.5)

# Tick marks
plt.xticks(range(0, 16, 2))
plt.yticks(range(0, 9, 1))

# Grid and legend
plt.grid(True, linestyle='--', alpha=0.7)
plt.legend()

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AB\AB.p4.v1\AB-replot.p4.v1.png", bbox_inches='tight', dpi=300)
plt.close()