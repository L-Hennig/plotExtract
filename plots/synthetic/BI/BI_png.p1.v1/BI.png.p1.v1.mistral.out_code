import matplotlib.pyplot as plt
import os

time_hours = [0.0, 2.5, 5.0, 7.5, 10.0, 12.5, 15.0, 17.5, 20.0]
bacterial_count = [7.0, 9.0, 10.5, 12.5, 10.0, 10.0, 12.5, 13.5, 12.0]

plt.figure(figsize=(8, 5))
plt.plot(time_hours, bacterial_count, marker='o', color='#1f77b4', linestyle='-', linewidth=2, markersize=8, label='Condition 1')

plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL)', fontsize=12)

plt.xlim(0, 21)
plt.ylim(0, 14.5)

plt.xticks([0, 2.5, 5, 7.5, 10, 12.5, 15, 17.5, 20], fontsize=10)
plt.yticks([0, 2, 4, 6, 8, 10, 12, 14], fontsize=10)

plt.grid(True, linestyle='--', alpha=0.6)
plt.legend(fontsize=10)

output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\BI\BI_png.p1.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "BI_png-replot.p1.v1.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()