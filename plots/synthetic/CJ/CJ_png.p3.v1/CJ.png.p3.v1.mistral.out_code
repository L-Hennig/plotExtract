import matplotlib.pyplot as plt

# Data
time_hours = [1, 3, 5, 10, 15, 24]
bacteria_count = [7.1, 6.5, 5.3, 6.0, 4.4, 1.5]

# Plot settings
plt.figure(figsize=(6, 4))
plt.scatter(time_hours, bacteria_count, color='#1f77b4', zorder=2)
plt.plot(time_hours, bacteria_count, color='#1f77b4', linestyle='-', linewidth=1, zorder=1)

# Axis labels and ranges
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.xlim(0, 25)
plt.ylim(0, 8)

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CJ\CJ_png.p3.v1\CJ_png-replot.p3.v1.png', bbox_inches='tight', dpi=300)
plt.close()