import matplotlib.pyplot as plt
import numpy as np

# Data
time = [0, 2, 4, 6, 8, 10, 12, 14]
cfu = [6.0, 5.3, 8.4, 5.0, 5.8, 5.5, 5.7, 6.0]

# Create plot
plt.figure(figsize=(6, 4))
plt.plot(time, cfu, color='#1f77b4', marker='o', markersize=8, linestyle='-', linewidth=2, label='Condition 1')

# Axis labels and limits
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacteria Count (CFU/mL)', fontsize=12)
plt.xlim(0, 14)
plt.ylim(0, 9)

# Tick marks
plt.xticks(np.arange(0, 15, 2))
plt.yticks(np.arange(0, 10, 2))

# Grid and legend
plt.grid(False)
plt.legend(frameon=False, fontsize=10)

# Save plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\BZ\BZ_png.p5.v1\BZ_png-replot.p5.v1.png', dpi=300, bbox_inches='tight')
plt.close()