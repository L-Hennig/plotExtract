import matplotlib.pyplot as plt
import os

# Data
time_hours = [0.0, 2.5, 5.0, 7.5, 10.0, 12.5, 15.0, 17.5, 20.0]
bacteria_count = [6.8, 10.0, 11.0, 10.0, 13.8, 10.0, 12.0, 11.8, 12.2]

# Plot settings
plt.figure(figsize=(8, 6))
plt.plot(time_hours, bacteria_count, marker='o', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')

# Axis ranges
plt.xlim(0, 21)
plt.ylim(0, 15)

# Tick marks
plt.xticks([0, 2.5, 5.0, 7.5, 10.0, 12.5, 15.0, 17.5, 20.0])
plt.yticks([0, 2, 4, 6, 8, 10, 12, 14])

# Legend
plt.legend()

# Save the plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\BO\BO_png.p3.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "BO_png-replot.p3.v1.png"), bbox_inches='tight', dpi=300)
plt.close()