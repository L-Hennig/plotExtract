import matplotlib.pyplot as plt
import os

data = [
    (0, 7.2), (1, 8.5), (2, 7.8), (3, 8.7), (4, 7.5),
    (5, 10.5), (6, 10.8), (7, 11.2), (8, 12.5), (9, 11.5),
    (10, 12.0), (11, 13.0), (12, 12.0), (13, 13.8), (14, 12.0),
    (15, 12.5), (16, 11.8), (17, 12.0), (18, 12.2), (19, 12.0),
    (20, 12.3), (21, 12.0), (22, 12.1), (23, 12.2), (24, 12.0)
]

time, bacteria_count = zip(*data)

plt.figure(figsize=(8, 5))
plt.plot(time, bacteria_count, marker='o', color='#1f77b4', linestyle='-', linewidth=1.5, markersize=6, label='Condition 1')

plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacteria Count (CFU/mL)', fontsize=12)
plt.xticks(range(0, 25, 1))
plt.yticks(range(0, 15, 2))
plt.xlim(0, 24)
plt.ylim(0, 14)
plt.grid(False)
plt.legend(loc='upper right', fontsize=10, frameon=False)

output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\BV\BV_png.p3.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "BV_png-replot.p3.v1.png")
plt.savefig(output_path, bbox_inches='tight', dpi=300)
plt.close()