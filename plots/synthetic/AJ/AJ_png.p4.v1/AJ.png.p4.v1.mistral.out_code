import matplotlib.pyplot as plt

# Data
time_hours = [0, 1, 2, 4, 6, 8, 10, 12, 14]
bacteria_count = [5.8, 10.0, 10.2, 10.0, 10.0, 10.3, 12.5, 12.8, 11.0]

# Plot settings
plt.figure(figsize=(6, 4))
plt.plot(time_hours, bacteria_count, marker='o', linestyle='-', color='#1f77b4', label='Condition 1')

# Axis labels and ranges
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.xlim(0, 15)
plt.ylim(0, 14)

# Tick marks
plt.xticks(range(0, 16, 2))
plt.yticks(range(0, 15, 2))

# Legend
plt.legend()

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\AJ\AJ_png.p4.v1\AJ_png-replot.p4.v1.png", bbox_inches='tight', dpi=300)
plt.close()