import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Data preparation
data = {
    'Time_C1': [0, 2, 4, 10],
    'CFU_C1': [6.0, 5.5, 5.0, 4.0],
    'Time_C2': [0, 2, 4, 6, 8, 10, 12],
    'CFU_C2': [6.0, 6.2, 6.3, 6.1, 6.0, 6.0, 5.8],
    'Time_C3': [0, 6, 8, 10, 12, 24],
    'CFU_C3': [6.0, 7.2, 7.4, 7.6, 7.7, 6.2]
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Plot Condition 1
ax.plot(data['Time_C1'], data['CFU_C1'], color='#1f77b4', linestyle='-', marker='o', markersize=8, label='Condition 1')

# Plot Condition 2
ax.plot(data['Time_C2'], data['CFU_C2'], color='#ff7f0e', linestyle='-', marker='s', markersize=8, label='Condition 2')

# Plot Condition 3
ax.plot(data['Time_C3'], data['CFU_C3'], color='#2ca02c', linestyle='-', marker='*', markersize=10, label='Condition 3')

# Set axis labels and title
ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacteria Count (CFU/mL)', fontsize=12)

# Set axis limits
ax.set_xlim(0, 24)
ax.set_ylim(0, 8.5)

# Set ticks
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 15, 20, 24])
ax.set_yticks([0, 2, 4, 6, 8])

# Add grid
ax.grid(True, linestyle='--', alpha=0.7)

# Add legend
ax.legend(loc='upper right', fontsize=10)

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CP\CP_png.p5.v1\CP_png-replot.p5.v1.png", dpi=300, bbox_inches='tight')
plt.close()