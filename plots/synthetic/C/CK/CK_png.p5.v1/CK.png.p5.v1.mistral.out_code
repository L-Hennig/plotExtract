import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Data preparation
data = {
    'Time_C1': [0, 2, 4, 8, 10, 12, 24],
    'CFU_C1': [6.7, 6.2, 6.5, 5.3, 3.5, 3.0, 2.5],
    'Time_C2': [0, 2, 4, 6, 8, 10, 12, 16, 20, 24],
    'CFU_C2': [6.1, 5.6, 5.3, 4.9, 4.5, 4.1, 3.7, 3.4, 2.9, 2.8]
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(6, 5))

# Plot Condition 1
ax.plot(data['Time_C1'], data['CFU_C1'], color='#1f77b4', marker='o', linestyle='-', linewidth=1.5, markersize=8, label='Condition 1')

# Plot Condition 2
ax.plot(data['Time_C2'], data['CFU_C2'], color='#ff7f0e', marker='o', linestyle='-', linewidth=1.5, markersize=8, label='Condition 2')

# Set axis labels and title
ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacteria Count (CFU/mL)', fontsize=12)

# Set axis limits
ax.set_xlim(0, 24)
ax.set_ylim(0, 7)

# Set axis ticks
ax.set_xticks(np.arange(0, 25, 4))
ax.set_yticks(np.arange(0, 8, 1))

# Add grid
ax.grid(True, linestyle='--', alpha=0.6)

# Add legend
ax.legend(loc='upper right', fontsize=10)

# Save the plot
plt.tight_layout()
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CK\CK_png.p5.v1\CK_png-replot.p5.v1.png", dpi=300)
plt.close()