import matplotlib.pyplot as plt
import numpy as np

# Data
time_cond1 = [0, 3, 6, 9, 12, 15, 24]
cfu_cond1 = [5.0, 6.5, 8.0, 6.0, 4.0, 2.0, 4.0]
time_cond2 = [0, 3, 6, 9, 12, 15, 24]
cfu_cond2 = [5.5, 5.8, 5.6, 5.0, 4.3, 4.0, 3.5]

# Create the plot
plt.figure(figsize=(6, 5))
plt.plot(time_cond1, cfu_cond1, marker='o', color='#1f77b4', label='Condition 1', linestyle='-')
plt.plot(time_cond2, cfu_cond2, marker='o', color='#ff7f0e', label='Condition 2', linestyle='-')

# Axis labels and title
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.xlim(0, 25)
plt.ylim(0, 9)

# Tick marks
plt.xticks(np.arange(0, 26, 5))
plt.yticks(np.arange(0, 10, 2))

# Legend
plt.legend()

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CF\CF_png.p5.v2\CF_png-replot.p5.v2.png", bbox_inches='tight', dpi=300)
plt.close()