import matplotlib.pyplot as plt
import numpy as np

# Data points extracted from the image
time_hours = [0, 2, 4, 6, 8, 10, 12, 24]
bacterial_count_log10 = [6.14, 5.08, 4.30, 3.85, 3.30, 2.70, 2.85, 3.60]

# Create the plot
fig, ax = plt.subplots(figsize=(6, 4))

# Plot the data points
ax.plot(time_hours, bacterial_count_log10,
        marker='o',
        color='black',
        linestyle='-',
        label='Condition 1')

# Axis break indication
ax.annotate('', xy=(12, 0), xycoords='data', xytext=(12, 1.5), textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black'))
ax.annotate('', xy=(20, 0), xycoords='data', xytext=(20, 1.5), textcoords='data',
            arrowprops=dict(arrowstyle='-', linestyle='--', color='black'))

# Set axis labels
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Set axis limits and ticks
ax.set_xlim(0, 26)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24, 26])

ax.set_ylim(0, 7)
ax.set_yticks([0, 1, 2, 3, 4, 5, 6, 7])

# Add legend
ax.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/C/CX/CX_png.pv2_prompt_4.v1\CX_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)
plt.close()