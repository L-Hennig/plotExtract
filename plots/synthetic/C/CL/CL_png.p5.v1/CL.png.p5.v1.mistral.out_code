import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Data preparation
data = {
    'Time_C1': [0, 2, 4, 6, 10, 15, 20],
    'CFU_C1': [5.8, 4.9, 4.7, 5.5, 6.0, 3.5, 3.4],
    'Time_C2': [0, 1, 3, 5, 8, 10, 15, 20],
    'CFU_C2': [5.8, 5.7, 5.4, 5.2, 4.9, 4.9, 4.0, 3.3]
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(6, 5))

# Plot Condition 1
ax.plot(data['Time_C1'], data['CFU_C1'], marker='o', color='#1f77b4', linestyle='-', linewidth=1.5, markersize=8, label='Condition 1')

# Plot Condition 2
ax.plot(data['Time_C2'], data['CFU_C2'], marker='o', color='#ff7f0e', linestyle='-', linewidth=1.5, markersize=8, label='Condition 2')

# Set axis labels and title
ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacteria Count (CFU/mL)', fontsize=12)

# Set axis limits
ax.set_xlim(0, 22)
ax.set_ylim(0, 7)

# Set ticks
ax.set_xticks([0, 5, 10, 15, 20])
ax.set_yticks([0, 2, 4, 6])

# Add legend
ax.legend(loc='upper right', fontsize=10, frameon=True)

# Save the plot
plt.tight_layout()
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CL\CL_png.p5.v1\CL_png-replot.p5.v1.png", dpi=300, bbox_inches='tight')
plt.close()