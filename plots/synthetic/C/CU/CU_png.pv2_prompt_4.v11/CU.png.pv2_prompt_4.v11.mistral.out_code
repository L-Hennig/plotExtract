import os
import matplotlib.pyplot as plt

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/C/CU\CU_png.pv2_prompt_4.v11\CU_png-replot.pv2_prompt_4.v11.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

time_points = [0, 2, 4, 6, 8, 10, 20, 24]
bacterial_counts = [6.0, 4.5, 4.2, 2.7, 2.5, 2.8, 3.1, 3.3]

plt.figure(figsize=(6, 4))
plt.plot(time_points, bacterial_counts, marker='o', color='black', linestyle='-', markersize=6, label='Condition 1')

plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

plt.xlim(0, 26)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 24, 26])
plt.gca().set_xticklabels(['0', '2', '4', '6', '8', '10', '12', '20', '24', '26'])

plt.gca().axvline(x=12, ymin=0.05, ymax=0.95, color='white', linewidth=2)
plt.gca().axvline(x=20, ymin=0.05, ymax=0.95, color='white', linewidth=2)
d = 0.015
kwargs = dict(transform=plt.gca().transAxes, color='k', clip_on=False)
plt.gca().plot((1 - d, 1 + d), (1 - d, 1 + d), **kwargs)
plt.gca().plot((1 - d, 1 + d), (-d, +d), **kwargs)
plt.gca().plot((-d / 4, +d / 4), (1 - d, 1 + d), **kwargs)
plt.gca().plot((-d / 4, +d / 4), (-d, +d), **kwargs)

plt.ylim(0, 6.5)
plt.yticks([0, 1, 2, 3, 4, 5, 6])
plt.gca().set_yticklabels(['0', '1', '2', '3', '4', '5', '6'])

plt.legend()
plt.savefig(replot_path, bbox_inches='tight', dpi=300)