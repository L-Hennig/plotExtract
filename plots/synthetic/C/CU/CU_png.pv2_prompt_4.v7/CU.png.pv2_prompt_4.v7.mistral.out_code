import matplotlib.pyplot as plt
import numpy as np
import os

# Data points from the provided facts
time = [0, 2, 4, 6, 8, 10, 12, 24]
bacterial_count = [6.0, 4.5, 2.7, 2.5, 2.6, 2.9, 3.1, 3.4]

# Create directory if it doesn't exist
output_dir = r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\C\C\CU\CU_png.pv2_prompt_4.v7'
os.makedirs(output_dir, exist_ok=True)

# Create the plot
plt.figure(figsize=(6, 4))
plt.plot(time, bacterial_count, marker='o', color='black', linestyle='-', label='Condition 1')

# Axis labels and limits
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.xlim(0, 26)
plt.ylim(0, 6.5)

# Custom ticks
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
plt.yticks([0, 1, 2, 3, 4, 5, 6])

# Axis break
plt.gca().spines['bottom'].set_bounds(0, 24)
plt.gca().set_xlim(0, 26)
plt.gca().set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 24])
plt.gap = np.array([(12, 20)])
for (xmin, xmax) in plt.gap:
    plt.axvspan(xmin, xmax, facecolor='white', edgecolor='white', zorder=10)
plt.plot([12, 20], [plt.ylim()[0], plt.ylim()[0]], color='black', linewidth=1, clip_on=False)
plt.plot([12, 20], [plt.ylim()[1], plt.ylim()[1]], color='black', linewidth=1, clip_on=False)

# Add diagonal break lines
plt.plot([12, 13], [plt.ylim()[0], plt.ylim()[0]+0.5], color='black', linewidth=1, clip_on=False)
plt.plot([19, 20], [plt.ylim()[0]+0.5, plt.ylim()[0]], color='black', linewidth=1, clip_on=False)

# Legend
plt.legend(loc='upper right')

# Save the plot
plt.savefig(os.path.join(output_dir, 'CU_png-replot.pv2_prompt_4.v7.png'), bbox_inches='tight', dpi=300)
plt.close()