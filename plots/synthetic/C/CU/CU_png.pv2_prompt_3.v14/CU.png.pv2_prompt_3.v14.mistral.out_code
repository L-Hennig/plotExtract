import matplotlib.pyplot as plt

# Data points
time_hours = [0, 2, 4, 6, 8, 10, 12, 20, 24]
bacterial_count_log10 = [6.0, 4.5, 4.2, 2.7, 2.5, 2.9, 3.1, 3.3, 3.4]

# Create the plot
plt.figure()
plt.plot(time_hours, bacterial_count_log10, marker='o', color='black', label='Condition 1')

# Axis labels and title
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Axis limits and ticks
plt.xlim(0, 26)
plt.ylim(0, 7)
plt.xticks(range(0, 27, 2))
plt.yticks(range(0, 8, 1))

# Legend
plt.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/CU/CU_png.pv2_prompt_3.v14/CU_png-replot.pv2_prompt_3.v14.png', bbox_inches='tight', dpi=300)

# Do not display the plot
plt.close()