import matplotlib.pyplot as plt
import os

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/C/CU\CU_png.pv2_prompt_4.v10\CU_png-replot.pv2_prompt_4.v10.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data points extracted from the plot
time = [0, 2, 4, 6, 8, 10, 12, 20, 24]
bacterial_count = [6, 4.7, 4.2, 2.7, 2.5, 2.8, 3.1, 3.3, 3.4]

# Create the plot
plt.figure(figsize=(6, 4))
plt.plot(time, bacterial_count, marker='o', color='black', linestyle='-', label='Condition 1')

# Axis labels and limits
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')
plt.xlim(0, 26)
plt.ylim(0, 6.5)

# Ticks
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
plt.yticks([0, 1, 2, 3, 4, 5, 6])

# Axis break representation
plt.annotate('', xy=(12, 0.1), xytext=(12, 0.5),
             arrowprops=dict(arrowstyle='-', lw=1.5, color='black'))
plt.annotate('', xy=(12, 3.5), xytext=(12, 3.9),
             arrowprops=dict(arrowstyle='-', lw=1.5, color='black'))

# Legend
plt.legend(loc='upper right')

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)