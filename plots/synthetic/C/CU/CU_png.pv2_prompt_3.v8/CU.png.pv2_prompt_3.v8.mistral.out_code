import matplotlib.pyplot as plt

# Data points extracted from the plot
time_hours = [0, 2, 4, 6, 8, 10, 12, 24]
bacterial_count_log10 = [6.0, 4.6, 4.3, 2.6, 2.5, 2.9, 3.2, 3.4]

# Create the plot
plt.figure(figsize=(6, 4))
plt.plot(time_hours, bacterial_count_log10, marker='o', color='black', label='Condition 1')

# Set axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Set axis limits and ticks
plt.xlim(0, 26)
plt.ylim(0, 6.5)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
plt.yticks([0, 1, 2, 3, 4, 5, 6])

# Add legend
plt.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CU\CU_png.pv2_prompt_3.v8\CU_png-replot.pv2_prompt_3.v8.png', bbox_inches='tight', dpi=300)

# Close the plot to prevent display
plt.close()