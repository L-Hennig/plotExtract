import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/C/CU\CU_png.pv2_prompt_4.v8\CU_png-replot.pv2_prompt_4.v8.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data points extracted from the plot
time_points = [0, 2, 4, 6, 8, 10, 12, 20, 22, 24]
bacterial_counts = [5.92, 4.6, 4.3, 2.7, 2.5, 2.9, 3.1, 3.3, 3.3, 3.45]  # log10 CFU/mL

# Create the plot
plt.figure(figsize=(6, 4))
plt.plot(time_points, bacterial_counts,
         color='black',
         marker='o',
         markersize=6,
         linestyle='-',
         linewidth=1.5,
         label='Condition 1')

# Axis labels and limits
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)
plt.xlim(0, 26)
plt.ylim(2, 6.5)

# Ticks
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24, 26], fontsize=10)
plt.yticks([2, 3, 4, 5, 6], fontsize=10)

# Axis break (simulated by adjusting the axis limits and adding a break symbol)
plt.gca().spines['left'].set_bounds(2, 6)
plt.gca().set_ylim(2, 6.5)

# Add axis break symbol
plt.gca().plot((0.01, 0.02), (0.01, 0.02), color='black', clip_on=False, transform=plt.gca().transAxes, linewidth=1.5)
plt.gca().plot((0.01, 0.02), (0.98, 0.99), color='black', clip_on=False, transform=plt.gca().transAxes, linewidth=1.5)

# Legend
plt.legend(loc='upper right', fontsize=10, frameon=False)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()