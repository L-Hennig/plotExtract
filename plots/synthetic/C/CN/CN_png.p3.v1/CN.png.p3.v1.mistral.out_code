import matplotlib.pyplot as plt
import pandas as pd

data = {
    'Time (hours)': [0, 3, 6, 9, 12, 24],
    'Bacteria Count (CFU/mL) (Condition 1)': [5.2, 7.5, 6.3, 6.1, 6.0, 6.0],
    'Bacteria Count (CFU/mL) (Condition 2)': [6.1, 6.0, 3.0, 4.0, 4.2, 3.3]
}

plt.figure(figsize=(6, 4))
plt.plot(data['Time (hours)'], data['Bacteria Count (CFU/mL) (Condition 1)'],
         color='black', linestyle='-', marker='o', label='Condition 1')
plt.plot(data['Time (hours)'], data['Bacteria Count (CFU/mL) (Condition 2)'],
         color='black', linestyle='-', marker='s', label='Condition 2')

plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.ylim(0, 8)
plt.xlim(0, 24)
plt.xticks([0, 3, 6, 9, 12, 15, 18, 21, 24])
plt.yticks([0, 2, 4, 6, 8])
plt.legend()
plt.grid(False)

