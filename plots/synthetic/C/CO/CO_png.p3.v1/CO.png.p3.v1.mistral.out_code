import matplotlib.pyplot as plt
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 24]
bacteria_cond1 = [6, 5.6, 5.2, 4.9, 4.4, 4, 3.7, 2.9]
time_cond2 = [0, 2, 4, 6, 8, 10, 12, 24]
bacteria_cond2 = [6, 6.7, 7.1, 7.4, 7.6, 7.7, 7.7, 7.5]

# Plot
plt.figure(figsize=(6, 5))
plt.plot(time_cond1, bacteria_cond1, color='black', linestyle='-', marker='o', label='Condition 1')
plt.plot(time_cond2, bacteria_cond2, color='black', linestyle='-', marker='o', markerfacecolor='white', label='Condition 2')

# Annotate significant points
significant_points_cond2 = [(2, 6.7), (4, 7.1), (6, 7.4), (10, 7.7), (12, 7.7)]
for point in significant_points_cond2:
    plt.plot(point[0], point[1], color='black', marker='*', markersize=10)

# Axis labels and limits
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.xlim(0, 25)
plt.ylim(0, 8.5)

# Legend
plt.legend()

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CO\CO_png.p3.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "CO_png-replot.p3.v1.png"), bbox_inches='tight', dpi=300)
plt.close()