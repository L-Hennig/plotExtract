import matplotlib.pyplot as plt
import numpy as np

# Data points from the provided facts
time_condition1 = [0, 2, 4, 6]
cfu_condition1 = [6, 2, 0.3, 0]

time_condition2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_condition2 = [6, 3.3, 0.7, 0, 0, 0, 0, 0]

# Create the plot
fig, ax = plt.subplots()

# Plot Condition 1
ax.plot(time_condition1, cfu_condition1, marker='o', color='black', label='Condition 1')

# Plot Condition 2
ax.plot(time_condition2, cfu_condition2, marker='s', color='black', label='Condition 2')

# Axis labels
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Axis limits and ticks
ax.set_xlim(0, 26)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
ax.set_ylim(0, 7)
ax.set_yticks([0, 1, 2, 3, 4, 5, 6, 7])

# Add axis break on x-axis
ax.annotate('', xy=(12.5, -0.2), xycoords='data', xytext=(19.5, -0.2), textcoords='data',
            arrowprops=dict(arrowstyle='-', shrinkA=0, shrinkB=0, linestyle='--'))
ax.annotate('', xy=(12.5, 7.2), xycoords='data', xytext=(19.5, 7.2), textcoords='data',
            arrowprops=dict(arrowstyle='-', shrinkA=0, shrinkB=0, linestyle='--'))

# Legend
ax.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/C/CZ/CZ_png.pv2_prompt_4.v1/CZ_png-replot.pv2_prompt_4.v1.png', bbox_inches='tight', dpi=300)

# Do not display the plot
plt.close()