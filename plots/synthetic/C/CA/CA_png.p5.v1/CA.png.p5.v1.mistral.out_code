import matplotlib.pyplot as plt
import numpy as np
import os

# Data
time_cond1 = [0, 2, 4, 6, 8, 10, 12, 14]
cfu_cond1 = [6.0, 5.8, 6.0, 5.8, 6.0, 5.8, 6.0, 6.0]

time_cond2 = [0, 2, 4, 6, 8, 10, 12, 14]
cfu_cond2 = [6.0, 6.0, 6.0, 6.0, 6.3, 6.3, 6.5, 6.5]

time_cond3 = [0, 2, 4, 6, 8, 10, 12, 14]
cfu_cond3 = [6.0, 6.0, 6.0, 5.8, 6.0, 5.8, 6.0, 5.8]

# Create plot
plt.figure(figsize=(6, 4))
plt.plot(time_cond1, cfu_cond1, marker='o', color='#1f77b4', linestyle='-', linewidth=1.5, label='Condition 1')
plt.plot(time_cond2, cfu_cond2, marker='o', color='#ff7f0e', linestyle='-', linewidth=1.5, label='Condition 2')
plt.plot(time_cond3, cfu_cond3, marker='o', color='#2ca02c', linestyle='-', linewidth=1.5, label='Condition 3')

# Axis labels and limits
plt.xlabel('Time (hours)', fontsize=12)
plt.ylabel('Bacteria Count (CFU/mL)', fontsize=12)
plt.xlim(0, 14)
plt.ylim(0, 7)
plt.xticks(np.arange(0, 15, 2))
plt.yticks(np.arange(0, 8, 1))

# Grid and legend
plt.grid(False)
plt.legend(loc='lower right', frameon=False)

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CA\CA_png.p5.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "CA_png-replot.p5.v1.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()