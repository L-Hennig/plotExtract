import matplotlib.pyplot as plt
import numpy as np

# Data points extracted from the image
time_hours = [0, 2, 4, 6, 8, 10, 12, 24]
bacterial_count_log10 = [6.0, 6.2, 6.4, 7.0, 7.6, 7.8, 7.9, 9.5]

# Create the plot
plt.figure(figsize=(6, 4))

# Plot the curve with markers
plt.plot(time_hours, bacterial_count_log10,
         marker='o',
         color='black',
         linestyle='-',
         label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Axis limits and ticks
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
plt.yticks([0, 2, 4, 6, 8, 10])

# Add axis break on x-axis between 12 and 24 hours
plt.gca().set_xlim(0, 26)  # Reset xlim to include break
plt.gca().spines['bottom'].set_bounds(0, 12)
plt.gca().plot([12, 24], [0, 0], color='white', linewidth=0)  # Hide connecting line
break_start = 12
break_end = 20
plt.gca().plot([break_start, break_start + 0.5], [-0.5, -0.5], color='black', linewidth=1)
plt.gca().plot([break_end - 0.5, break_end], [-0.5, -0.5], color='black', linewidth=1)

# Add legend
plt.legend()

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\C\CV\CV_png.pv2_prompt_4.v2\CV_png-replot.pv2_prompt_4.v2.png', bbox_inches='tight', dpi=300)
plt.close()