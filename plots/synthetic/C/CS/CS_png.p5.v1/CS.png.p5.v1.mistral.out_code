import matplotlib.pyplot as plt
import os

# Data
time = [0, 2, 4, 6, 8, 10, 12, 16, 20, 24]
cfu = [6.3, 5.8, 5.6, 5.4, 5.0, 4.6, 4.3, 3.8, 2.9, 2.7]

# Create plot
plt.figure(figsize=(6, 4))
plt.plot(time, cfu, color='black', linestyle='-', marker='o', markersize=6, markerfacecolor='black', markeredgecolor='black', label='Condition 1')

# Axis labels and limits
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.xlim(0, 24)
plt.ylim(0, 7)

# Tick marks
plt.xticks([0, 5, 10, 15, 20])
plt.yticks([0, 2, 4, 6])

# Remove legend (not present in original)
plt.tight_layout()

# Save plot
output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CS\CS_png.p5.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "CS_png-replot.p5.v1.png")
plt.savefig(output_path, dpi=300, bbox_inches='tight')
plt.close()