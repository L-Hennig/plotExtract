import matplotlib.pyplot as plt

# Data
time_hours = [0, 5, 7, 10, 15, 20]
bacteria_count = [6.2, 5.6, 5.2, 4.7, 4.1, 3.2]

# Plot settings
plt.figure(figsize=(5, 4))
plt.plot(time_hours, bacteria_count, color='black', marker='o', linestyle='-', label='Condition 1')

# Axis labels and limits
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.xlim(0, 22)
plt.ylim(0, 7)
plt.xticks(range(0, 25, 5))
plt.yticks(range(0, 8, 1))

# Legend
plt.legend(loc='upper right', frameon=False)

# Save plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CS\CS_png.pv2_prompt_1.v6\CS_png-replot.pv2_prompt_1.v6.png', bbox_inches='tight', dpi=300)