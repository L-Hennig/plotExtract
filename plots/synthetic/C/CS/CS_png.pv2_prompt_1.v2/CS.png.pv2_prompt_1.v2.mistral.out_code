```python
import matplotlib.pyplot as plt

# Data
time_hours = [0, 5, 7, 10, 15, 20]
bacteria_count = [6.2, 5.6, 5.3, 4.8, 4.1, 3.2]

# Plot configuration
plt.figure(figsize=(6, 4))
plt.plot(time_hours, bacteria_count, marker='o', color='black', linestyle='-', label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')

# Axis limits and ticks
plt.xlim(0, 22)
plt.ylim(0, 7)
plt.xticks([0, 5, 10, 15, 20])
plt.yticks([0, 2, 4, 6])

# Legend
plt.legend(loc='upper right')

# Save the plot
plt.savefig(r'C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CS\CS_png.pv2_prompt_1.v2\CS_png-replot.pv2_prompt_1.v2.png', bbox_inches='tight', dpi=300)

# Close the plot
plt.close()
```