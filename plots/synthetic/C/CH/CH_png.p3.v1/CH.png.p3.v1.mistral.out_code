import matplotlib.pyplot as plt
import pandas as pd
import os

data = {
    'Time (hours)': [0, 3, 6, 9, 12, 15, 18, 21],
    'Bacteria Count (CFU/mL) (Condition 1)': [7, 6, 4, 8, 6, 5.5, 5, 3.5],
    'Bacteria Count (CFU/mL) (Condition 2)': [6, 5.5, 5, 4.5, 4, 3.5, 3, 2.5],
    'Bacteria Count (CFU/mL) (Condition 3)': [6, 6.5, 7, 7.5, 7.5, 7.75, 8, 8],
    'Bacteria Count (CFU/mL) (Condition 4)': [5, 4, 3.5, 3, 3.5, 3.75, 3.75, 4]
}

df = pd.DataFrame(data)

plt.figure(figsize=(8, 6))
plt.plot(df['Time (hours)'], df['Bacteria Count (CFU/mL) (Condition 1)'], marker='o', color='#1f77b4', label='Condition 1')
plt.plot(df['Time (hours)'], df['Bacteria Count (CFU/mL) (Condition 2)'], marker='o', color='#ff7f0e', label='Condition 2')
plt.plot(df['Time (hours)'], df['Bacteria Count (CFU/mL) (Condition 3)'], marker='o', color='#2ca02c', label='Condition 3')
plt.plot(df['Time (hours)'], df['Bacteria Count (CFU/mL) (Condition 4)'], marker='o', color='#d62728', label='Condition 4')

plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.ylim(0, 9)
plt.xlim(0, 22)
plt.xticks(range(0, 22, 3))
plt.yticks(range(0, 10, 1))
plt.legend()
plt.grid(True)

output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CH\CH_png.p3.v1"
os.makedirs(output_dir, exist_ok=True)
output_path = os.path.join(output_dir, "CH_png-replot.p3.v1.png")
plt.savefig(output_path)
plt.close()