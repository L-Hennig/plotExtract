import matplotlib.pyplot as plt
import pandas as pd
import os

data = {
    "Time (hours)": [0, 3, 6, 9, 12, 18, 24],
    "Bacteria Count (CFU/mL) (Condition 1)": [6.0, 6.1, 6.0, 6.0, 5.9, 6.0, 6.1],
    "Bacteria Count (CFU/mL) (Condition 2)": [6.0, 5.5, 4.9, 4.5, 4.0, 3.8, 4.5],
    "Bacteria Count (CFU/mL) (Condition 3)": [6.0, 7.2, 7.4, 7.6, 7.9, 8.0, 7.9],
    "Bacteria Count (CFU/mL) (Condition 4)": [6.0, 5.0, 4.2, 3.6, 3.4, 3.0, 3.3]
}

df = pd.DataFrame(data)

plt.figure(figsize=(8, 6))

# Plot Condition 1
plt.plot(df["Time (hours)"], df["Bacteria Count (CFU/mL) (Condition 1)"],
         color='black', linestyle='-', marker='s', label='Condition 1')

# Plot Condition 2
plt.plot(df["Time (hours)"], df["Bacteria Count (CFU/mL) (Condition 2)"],
         color='black', linestyle='--', marker='o', label='Condition 2')

# Plot Condition 3
plt.plot(df["Time (hours)"], df["Bacteria Count (CFU/mL) (Condition 3)"],
         color='black', linestyle='-', marker='^', label='Condition 3')

# Plot Condition 4
plt.plot(df["Time (hours)"], df["Bacteria Count (CFU/mL) (Condition 4)"],
         color='black', linestyle='-', marker='v', label='Condition 4')

plt.xlabel('Time (hours)')
plt.ylabel('Bacteria Count (CFU/mL)')
plt.ylim(0, 8.5)
plt.xlim(0, 25)
plt.xticks([0, 5, 10, 15, 20, 25])
plt.yticks([0, 2, 4, 6, 8])
plt.legend()

output_dir = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\CQ\CQ_png.p3.v1"
os.makedirs(output_dir, exist_ok=True)
plt.savefig(os.path.join(output_dir, "CQ_png-replot.p3.v1.png"))
plt.close()