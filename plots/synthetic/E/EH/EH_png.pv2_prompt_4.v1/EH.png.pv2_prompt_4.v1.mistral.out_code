import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EH\EH_png.pv2_prompt_4.v1\EH_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
data = {
    "Condition 1": {
        "x": [0, 2, 4, 6, 8, 10, 12, 24],
        "y": [6.0, 5.9, 6.8, 8.0, 8.0, 8.1, 8.6, 9.2]
    },
    "Condition 2": {
        "x": [0, 2, 24],
        "y": [6.0, 1.0, 3.5]
    },
    "Condition 3": {
        "x": [0, 2, 4, 6, 8, 10, 12, 24],
        "y": [6.0, 8.0, 8.3, 8.3, 8.1, 8.1, 8.1, 8.0]
    }
}

# Create plot
plt.figure(figsize=(8, 6))

# Plot each condition with specific markers and styles
plt.plot(data["Condition 1"]["x"], data["Condition 1"]["y"],
         marker='s', color='black', linestyle='-', label='Condition 1')
plt.plot(data["Condition 2"]["x"], data["Condition 2"]["y"],
         marker='^', color='black', linestyle='-', label='Condition 2')
plt.plot(data["Condition 3"]["x"], data["Condition 3"]["y"],
         marker='o', color='black', linestyle='-', label='Condition 3')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Axis limits
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24])
plt.yticks([0, 2, 4, 6, 8, 10])

# Axis break indication
plt.plot([12, 12.5], [10.2, 10.2], color='black', linewidth=1)
plt.plot([12, 12.5], [10.2, 10.2], color='white', linestyle='--', linewidth=1)

# Legend
plt.legend()

# Save plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()