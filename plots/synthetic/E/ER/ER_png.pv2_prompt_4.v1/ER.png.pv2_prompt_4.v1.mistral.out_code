import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/ER\ER_png.pv2_prompt_4.v1\ER_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
curves_data = [
    {
        "label": "Condition 1",
        "points": [
            {"x": 0, "y": 6.0},
            {"x": 2, "y": 7.8},
            {"x": 4, "y": 8.2},
            {"x": 6, "y": 8.0},
            {"x": 8, "y": 7.8},
            {"x": 10, "y": 8.5},
            {"x": 12, "y": 8.6},
            {"x": 24, "y": 8.6}
        ],
        "marker": "s",
        "linestyle": "-",
        "color": "#333333"
    },
    {
        "label": "Condition 2",
        "points": [
            {"x": 0, "y": 6.0},
            {"x": 2, "y": 6.0},
            {"x": 4, "y": 6.1},
            {"x": 6, "y": 6.1},
            {"x": 8, "y": 6.1},
            {"x": 24, "y": 6.5}
        ],
        "marker": "^",
        "linestyle": "--",
        "color": "#666666"
    },
    {
        "label": "Condition 3",
        "points": [
            {"x": 0, "y": 6.0},
            {"x": 2, "y": 7.5},
            {"x": 4, "y": 8.7},
            {"x": 6, "y": 8.9},
            {"x": 8, "y": 9.0},
            {"x": 10, "y": 9.0},
            {"x": 12, "y": 9.0},
            {"x": 24, "y": 9.0}
        ],
        "marker": "o",
        "linestyle": ":",
        "color": "#000000"
    },
    {
        "label": "Condition 4",
        "points": [
            {"x": 0, "y": 6.0},
            {"x": 2, "y": 0.5},
            {"x": 4, "y": 0.3},
            {"x": 6, "y": 0.5},
            {"x": 8, "y": 2.3},
            {"x": 10, "y": 0.8},
            {"x": 12, "y": 0.5},
            {"x": 24, "y": 2.0}
        ],
        "marker": "v",
        "linestyle": "-",
        "color": "#999999"
    }
]

# Create the plot
plt.figure(figsize=(8, 6))

for curve in curves_data:
    x_vals = [p["x"] for p in curve["points"]]
    y_vals = [p["y"] for p in curve["points"]]
    plt.plot(x_vals, y_vals,
             marker=curve["marker"],
             linestyle=curve["linestyle"],
             color=curve["color"],
             label=curve["label"],
             markersize=8,
             linewidth=2)

# Axis labels
plt.xlabel("Time (hours)", fontsize=12)
plt.ylabel("Bacterial Count (CFU/mL) (log10 scale)", fontsize=12)

# X-axis settings
plt.xlim(0, 26)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24], ["0", "2", "4", "6", "8", "10", "12", "24"])

# Y-axis settings
plt.ylim(0, 10)
plt.yticks([0, 2, 4, 6, 8, 9, 10], ["0", "2", "4", "6", "8", "9", "10"])

# Add axis break indication
plt.axvline(x=16, ymin=0.05, ymax=0.95, color='white', linewidth=2)
plt.axvline(x=16, ymin=0.05, ymax=0.1, color='black', linewidth=1)
plt.axvline(x=16, ymin=0.9, ymax=0.95, color='black', linewidth=1)

# Legend
plt.legend(loc='upper right', fontsize=10, frameon=True)

# Grid
plt.grid(True, which='both', linestyle='--', linewidth=0.5, alpha=0.7)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)