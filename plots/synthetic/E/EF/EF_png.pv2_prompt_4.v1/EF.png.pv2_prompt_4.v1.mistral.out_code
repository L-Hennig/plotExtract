import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EF\EF_png.pv2_prompt_4.v1\EF_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
time_condition1 = [0, 2, 4, 6, 8, 10, 12, 22, 24]
count_condition1 = [6.0, 6.0, 6.0, 5.8, 5.8, 5.8, 5.8, 5.6, 5.5]

time_condition2 = [0, 2, 4, 6, 8, 10, 12, 20, 22, 24]
count_condition2 = [6.0, 3.8, 3.0, 3.0, 3.2, 3.3, 3.5, 5.8, 6.8, 7.0]

# Create the plot
plt.figure(figsize=(8, 6))

# Plot Condition 1
plt.plot(time_condition1, count_condition1, marker='o', color='black', linestyle='-', label='Condition 1')

# Plot Condition 2
plt.plot(time_condition2, count_condition2, marker='o', color='black', linestyle='-', markerfacecolor='white', label='Condition 2')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Axis limits
plt.xlim(0, 26)
plt.ylim(0, 10)

# Ticks
plt.xticks([0, 2, 4, 6, 8, 10, 12, 20, 22, 24])
plt.yticks([0, 2, 3, 4, 5, 6, 7, 8, 9, 10])

# Axis break indication
plt.gca().axvline(x=16, ymin=0.4, ymax=0.6, color='black', linewidth=1.5)
plt.gca().plot([15.5, 16.5], [plt.ylim()[0]+0.5, plt.ylim()[0]+0.5], color='white', linewidth=2, solid_capstyle='butt')
plt.gca().plot([15.5, 16.5], [plt.ylim()[0]+0.5, plt.ylim()[0]+0.5], color='black', linewidth=1, solid_capstyle='butt')

# Legend
plt.legend()

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()