import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EI\EI_png.pv2_prompt_4.v1\EI_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
data = {
    "Condition 1": [
        (0, 6.0), (2, 7.2), (4, 8.6), (6, 8.8), (8, 8.9), (10, 9.0), (12, 9.0), (24, 9.2)
    ],
    "Condition 2": [
        (0, 6.0), (2, 1.5), (4, 1.3), (8, 1.5), (10, 1.6), (24, 0.7)
    ],
    "Condition 3": [
        (0, 6.0), (2, 7.0), (4, 8.0), (6, 8.2), (8, 8.9), (10, 9.0), (12, 9.0), (24, 9.2)
    ],
    "Condition 4": [
        (0, 6.0), (2, 3.8), (4, 2.5), (6, 2.0), (10, 2.0), (12, 2.0), (24, 2.5)
    ]
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Plot each condition with specific markers and lines
markers = ['s', '^', 'o', 'D']
colors = ['black', 'black', 'black', 'black']
linestyles = ['-', '-', '-', '-']

for i, (condition, points) in enumerate(data.items()):
    x_vals = [p[0] for p in points if p[1] is not None]
    y_vals = [p[1] for p in points if p[1] is not None]
    ax.plot(x_vals, y_vals, marker=markers[i], color=colors[i], linestyle=linestyles[i], label=condition)

# Set axis limits and ticks
ax.set_xlim(0, 26)
ax.set_ylim(0, 10)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 24])
ax.set_yticks([0, 2, 4, 6, 8, 10])

# Axis labels
ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

# Add axis break indication
ax.plot([12, 12.5], [10.5, 10.5], color='black', linewidth=1)
ax.plot([12, 12.5], [10.3, 10.3], color='white', linewidth=3)
ax.plot([12, 12.5], [10.5, 10.5], color='black', linewidth=1)

# Add legend
ax.legend(loc='upper left', fontsize=10)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()