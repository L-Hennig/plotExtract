import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EX\EX_png.pv2_prompt_4.v1\EX_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
curves_data = [
    {
        "label": "Condition 1",
        "points": [
            {"x": 0, "y": 6.1},
            {"x": 8, "y": 8.0},
            {"x": 10, "y": 8.0},
            {"x": 12, "y": 8.0},
            {"x": 24, "y": 8.0}
        ],
        "marker": "s",
        "linestyle": "-",
        "color": "#000000"
    },
    {
        "label": "Condition 2",
        "points": [
            {"x": 0, "y": 6.1},
            {"x": 2, "y": 5.3},
            {"x": 4, "y": 5.4},
            {"x": 6, "y": 5.4},
            {"x": 8, "y": 5.4},
            {"x": 10, "y": 5.4},
            {"x": 12, "y": 5.4},
            {"x": 24, "y": 5.4}
        ],
        "marker": "^",
        "linestyle": "--",
        "color": "#000000"
    },
    {
        "label": "Condition 3",
        "points": [
            {"x": 0, "y": 6.1},
            {"x": 2, "y": 3.0},
            {"x": 4, "y": 3.0},
            {"x": 6, "y": 8.8},
            {"x": 8, "y": 8.9},
            {"x": 10, "y": 9.0},
            {"x": 12, "y": 9.1},
            {"x": 24, "y": 9.2}
        ],
        "marker": "o",
        "linestyle": ":",
        "color": "#000000"
    },
    {
        "label": "Condition 4",
        "points": [
            {"x": 0, "y": 6.1},
            {"x": 2, "y": 2.0},
            {"x": 4, "y": 2.0},
            {"x": 6, "y": 2.1}
        ],
        "marker": "v",
        "linestyle": "-",
        "color": "#000000"
    },
    {
        "label": "Condition 5",
        "points": [
            {"x": 0, "y": 6.1},
            {"x": 2, "y": 1.5},
            {"x": 4, "y": 1.3},
            {"x": 6, "y": 2.5},
            {"x": 8, "y": 3.0},
            {"x": 10, "y": 3.0},
            {"x": 12, "y": 1.0},
            {"x": 24, "y": 2.7}
        ],
        "marker": "D",
