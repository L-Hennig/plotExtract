import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EC\EC_png.pv2_prompt_4.v1\EC_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
time_points = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_values = [6.0, 4.2, 4.0, 3.9, 4.6, 4.8, 4.7, 8.4]

# Create the plot
plt.figure(figsize=(6, 5))
plt.plot(time_points, cfu_values,
         marker='o',
         markersize=6,
         markerfacecolor='black',
         markeredgecolor='black',
         linestyle='--',
         color='black',
         label='Condition 1')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# X-axis settings
plt.xlim(0, 26)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24])

# Y-axis settings (linear scale since data is already log10)
plt.ylim(0, 10)
plt.yticks([0, 2, 4, 6, 8, 10])

# Add axis break indication
plt.annotate('', xy=(12, 0), xytext=(12, 0.5),
             arrowprops=dict(arrowstyle='-', lw=1.5))
plt.annotate('', xy=(20, 0), xytext=(20, 0.5),
             arrowprops=dict(arrowstyle='-', lw=1.5))
plt.plot([12, 20], [0.25, 0.25], color='black', lw=1.5)
plt.plot([12, 20], [0.75, 0.75], color='black', lw=1.5)

# Legend
plt.legend(loc='upper left')

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()