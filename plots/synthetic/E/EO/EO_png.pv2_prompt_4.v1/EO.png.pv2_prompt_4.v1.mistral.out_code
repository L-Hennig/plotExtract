import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EO\EO_png.pv2_prompt_4.v1\EO_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
curves_data = [
    {
        "label": "Condition 1",
        "points": [
            {"x": 0, "y": 6.0},
            {"x": 2, "y": 8.0},
            {"x": 4, "y": 8.5},
            {"x": 6, "y": 9.0},
            {"x": 8, "y": 8.5},
            {"x": 10, "y": 8.6},
            {"x": 24, "y": 8.3}
        ],
        "marker": "s",
        "linestyle": "-",
        "color": "black"
    },
    {
        "label": "Condition 2",
        "points": [
            {"x": 0, "y": 6.0},
            {"x": 2, "y": 5.8},
            {"x": 4, "y": 5.5},
            {"x": 6, "y": 5.3},
            {"x": 24, "y": 6.2}
        ],
        "marker": "^",
        "linestyle": "--",
        "color": "black"
    },
    {
        "label": "Condition 3",
        "points": [
            {"x": 0, "y": 6.0},
            {"x": 2, "y": 6.8},
            {"x": 4, "y": 7.5},
            {"x": 6, "y": 8.0},
            {"x": 8, "y": 8.1},
            {"x": 10, "y": 8.2},
            {"x": 24, "y": 8.3}
        ],
        "marker": "o",
        "linestyle": ":",
        "color": "black"
    }
]

# Create the plot
plt.figure(figsize=(8, 6))

# Plot each curve
for curve in curves_data:
    x_vals = [p["x"] for p in curve["points"]]
    y_vals = [p["y"] for p in curve["points"]]
    plt.plot(x_vals, y_vals,
             marker=curve["marker"],
             linestyle=curve["linestyle"],
             color=curve["color"],
             label=curve["label"])

# Axis settings
plt.xlim(0, 26)
plt.ylim(0, 10)

# X-axis ticks and break
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24], ["0", "2", "4", "6", "8", "10", "12", "24"])
plt.gca().set_xlabel("Time (hours)", fontsize=12)

# Add axis break indicator
plt.gca().plot([11.5, 12.5], [0, 0], color="white", linewidth=4, transform=plt.gca().get_xaxis_transform())
plt.gca().plot([11.5, 12.5], [0, 0], color="black", linewidth=1.5, transform=plt.gca().get_xaxis_transform(), linestyle="--")

# Y-axis ticks
plt.yticks([2, 4, 6, 8, 10], ["2", "4", "6", "8", "10"])
plt.gca().set_ylabel("Bacterial Count (CFU/mL) (log10 scale)", fontsize=12)

# Legend
plt.legend(loc="upper left", fontsize=10)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()