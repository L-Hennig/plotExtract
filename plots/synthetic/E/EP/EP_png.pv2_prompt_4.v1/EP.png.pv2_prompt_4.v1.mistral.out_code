import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EP\EP_png.pv2_prompt_4.v1\EP_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
time_condition1 = [0, 2, 4, 6, 8, 10, 12, 24]
count_condition1 = [6.0, 7.5, 7.9, 8.0, 7.9, 7.8, 7.7, 7.7]

time_condition2 = [0, 2, 4, 6, 8, 12, 24]
count_condition2 = [6.0, 5.2, 5.1, 5.1, 5.2, 5.3, 5.5]

time_condition3 = [0, 2, 4, 6, 8, 10, 12, 24]
count_condition3 = [6.0, 5.8, 6.4, 6.7, 7.0, 7.2, 7.3, 8.3]

# Create the plot
plt.figure(figsize=(8, 6))

# Plot each condition with specific styles
plt.plot(time_condition1, count_condition1, 's-', color='black', markersize=8, label='Condition 1')
plt.plot(time_condition2, count_condition2, '^--', color='black', markersize=8, label='Condition 2')
plt.plot(time_condition3, count_condition3, 'o:', color='black', markersize=8, label='Condition 3')

# Axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Axis limits and ticks
plt.xlim(0, 26)
plt.ylim(4, 9)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24])
plt.yticks([4, 5, 6, 7, 8, 9, 10])

# Axis break indication
plt.plot([12.5, 13.5], [3.8, 3.8], 'k-', lw=1.5)  # Bottom break line
plt.plot([12.5, 13.5], [9.2, 9.2], 'k-', lw=1.5)  # Top break line

# Legend
plt.legend()

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()