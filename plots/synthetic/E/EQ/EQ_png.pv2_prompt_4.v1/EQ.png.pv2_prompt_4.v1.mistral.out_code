import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EQ\EQ_png.pv2_prompt_4.v1\EQ_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
time_condition1 = [0, 2, 4, 6, 8, 10, 24]
count_condition1 = [6.0, 7.8, 8.5, 8.7, 8.9, 9.0, 8.9]

time_condition2 = [0, 2, 4, 6, 8, 10, 12, 24]
count_condition2 = [6.0, 5.6, 5.6, 5.6, 5.6, 5.6, 5.6, 5.2]

time_condition3 = [0, 2, 4, 6, 8, 10, 12, 24]
count_condition3 = [6.0, 7.0, 7.8, 8.0, 8.2, 8.4, 8.6, 8.8]

# Create the plot
plt.figure(figsize=(8, 6))

# Plot each condition with specific markers and line styles
plt.plot(time_condition1, count_condition1, 's-', color='black', label='Condition 1', markersize=8, markerfacecolor='black', markeredgecolor='black')
plt.plot(time_condition2, count_condition2, '^--', color='black', label='Condition 2', markersize=8, markerfacecolor='black', markeredgecolor='black')
plt.plot(time_condition3, count_condition3, 'o:', color='black', label='Condition 3', markersize=8, markerfacecolor='black', markeredgecolor='black')

# Set axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Set axis limits
plt.xlim(0, 26)
plt.ylim(4, 10)

# Set ticks
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24])
plt.yticks([4, 5, 6, 7, 8, 9, 10])

# Add axis break indication on x-axis
plt.annotate('', xy=(12.5, 4.1), xytext=(19.5, 4.1),
             arrowprops=dict(arrowstyle='-', color='black', lw=1.5))
plt.annotate('', xy=(12.5, 4.2), xytext=(19.5, 4.2),
             arrowprops=dict(arrowstyle='-', color='black', lw=1.5))

# Add legend
plt.legend()

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)