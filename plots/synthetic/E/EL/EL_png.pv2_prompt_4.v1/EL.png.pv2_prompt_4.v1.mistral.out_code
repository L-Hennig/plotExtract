import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EL\EL_png.pv2_prompt_4.v1\EL_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
time_condition1 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_condition1 = [6.0, 8.2, 8.7, 8.8, 8.9, 8.9, 9.0, 9.0]

time_condition2 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_condition2 = [6.0, 7.8, 8.6, 8.7, 8.8, 8.9, 8.9, 8.0]

time_condition3 = [0, 2, 4, 6, 8, 10, 12, 24]
cfu_condition3 = [6.0, 7.0, 8.3, 8.0, 7.9, 8.0, 8.1, 9.0]

# Create the plot
plt.figure(figsize=(8, 6))

# Plot each condition with specific markers and line styles
plt.plot(time_condition1, cfu_condition1, 's-', color='black', label='Condition 1', markersize=8)
plt.plot(time_condition2, cfu_condition2, '^--', color='black', label='Condition 2', markersize=8)
plt.plot(time_condition3, cfu_condition3, 'o:', color='black', label='Condition 3', markersize=8)

# Set axis limits and ticks
plt.xlim(0, 26)
plt.ylim(0, 10)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 24])
plt.yticks([0, 2, 4, 6, 8, 9, 10])

# Add axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Add legend
plt.legend()

# Add axis break indication on x-axis
plt.annotate('', xy=(12, 0), xytext=(20, 0),
             arrowprops=dict(arrowstyle='<->', color='black', lw=1.5),
             xycoords='data', annotation_clip=False)
plt.annotate('', xy=(12, -0.5), xytext=(20, -0.5),
             arrowprops=dict(arrowstyle='-', color='white', lw=2),
             xycoords='data', annotation_clip=False)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)