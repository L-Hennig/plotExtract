import matplotlib.pyplot as plt
import os
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EU\EU_png.pv2_prompt_4.v1\EU_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
data = {
    "Condition 1": {
        "x": [0, 2, 4, 6, 8, 10, 12, 24],
        "y": [6.0, 8.0, 8.7, 8.8, 8.6, 8.7, 8.8, 8.9]
    },
    "Condition 2": {
        "x": [0, 2, 4, 6, 8, 10, 12],
        "y": [6.0, 5.8, 5.7, 5.7, 5.7, 5.7, 5.7]
    },
    "Condition 3": {
        "x": [0, 2, 4, 6, 8, 10, 24],
        "y": [6.0, 7.0, 7.5, 7.8, 8.0, 8.1, 8.3]
    },
    "Condition 4": {
        "x": [0, 2, 4, 6, 24],
        "y": [6.0, 4.5, 2.0, 1.5, 1.0]
    }
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Plot each condition with specific styles
ax.plot(data["Condition 1"]["x"], data["Condition 1"]["y"],
        marker='s', color='black', linestyle='-', label='Condition 1')
ax.plot(data["Condition 2"]["x"], data["Condition 2"]["y"],
        marker='^', color='black', linestyle='--', label='Condition 2')
ax.plot(data["Condition 3"]["x"], data["Condition 3"]["y"],
        marker='o', color='black', linestyle=':', label='Condition 3')
ax.plot(data["Condition 4"]["x"], data["Condition 4"]["y"],
        marker='v', color='black', linestyle='-', label='Condition 4')

# Axis labels
ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

# Axis limits and ticks
ax.set_xlim(0, 26)
ax.set_ylim(0, 10)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 20, 24])
ax.set_xticklabels(['0', '2', '4', '6', '8', '10', '12', '', '24'])
ax.set_yticks([0, 2, 4, 6, 8, 10])
ax.set_yticklabels(['0', '2', '4', '6', '8', '10'])

# Add axis break on x-axis
ax.plot([12.5, 12.5], [0, 10], color='white', linewidth=5)  # Cover line
ax.plot([12, 12], [0, 10], color='black', linestyle='-', linewidth=1.5)
ax.plot([20, 20], [0, 10], color='black', linestyle='-', linewidth=1.5)
ax.annotate('', xy=(12, 10), xytext=(20, 10),
            arrowprops=dict(arrowstyle='-', color='black', lw=1.5))
ax.annotate('', xy=(12, 0), xytext=(20, 0),
            arrowprops=dict(arrowstyle='-', color='black', lw=1.5))

# Legend
ax.legend(loc='upper left', fontsize=10)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()