import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EB\EB_png.pv2_prompt_4.v1\EB_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
time_points = [0, 2, 4, 6, 8, 10, 12, 24]
bacterial_counts = [6.0, 3.7, 3.3, 3.2, 3.1, 3.3, 3.8, 6.8]

# Create the plot
plt.figure(figsize=(6, 4))

# Plot the curve with markers and dashed line
plt.plot(time_points, bacterial_counts,
         marker='o',
         markersize=6,
         markerfacecolor='black',
         markeredgecolor='black',
         linestyle='--',
         color='black',
         label='Condition 1')

# Set axis limits
plt.xlim(0, 26)
plt.ylim(0, 10)

# Set axis labels
plt.xlabel('Time (hours)')
plt.ylabel('Bacterial Count (CFU/mL) (log10 scale)')

# Set x-axis ticks and handle the break
x_ticks = [0, 2, 4, 6, 8, 10, 12, 24]
plt.xticks(x_ticks)

# Add axis break indicator
plt.annotate('', xy=(12.5, 0), xytext=(19.5, 0),
             arrowprops=dict(arrowstyle='-', color='black', lw=1.5))
plt.annotate('', xy=(12.5, 0.5), xytext=(19.5, 0.5),
             arrowprops=dict(arrowstyle='-', color='black', lw=1.5))
plt.annotate('//', xy=(13, 0.25), fontsize=12, weight='bold')

# Set y-axis ticks
y_ticks = [0, 2, 3, 4, 5, 6, 7, 8, 9, 10]
plt.yticks(y_ticks)

# Add legend
plt.legend()

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()