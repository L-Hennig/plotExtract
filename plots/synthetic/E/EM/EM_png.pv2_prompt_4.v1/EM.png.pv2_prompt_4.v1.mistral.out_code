import os
import matplotlib.pyplot as plt

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic/E/EM\EM_png.pv2_prompt_4.v1\EM_png-replot.pv2_prompt_4.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

data = {
    "Condition 1": {
        "x": [0, 2, 4, 6, 8, 10, 12, 24],
        "y": [6.0, 7.9, 8.3, 8.5, 8.3, 8.2, 8.1, 8.0]
    },
    "Condition 2": {
        "x": [0, 2, 4, 6, 8, 10, 24],
        "y": [6.0, 7.8, 8.2, 8.4, 8.5, 8.5, 8.3]
    },
    "Condition 3": {
        "x": [0, 2, 4, 6, 8, 10, 24],
        "y": [6.0, 8.0, 8.9, 9.1, 9.2, 9.2, 8.6]
    }
}

fig, ax = plt.subplots(figsize=(8, 6))

line1, = ax.plot(data["Condition 1"]["x"], data["Condition 1"]["y"],
                 color='black', linestyle='-', marker='s', markersize=6, label='Condition 1')
line2, = ax.plot(data["Condition 2"]["x"], data["Condition 2"]["y"],
                 color='black', linestyle='--', marker='^', markersize=6, label='Condition 2')
line3, = ax.plot(data["Condition 3"]["x"], data["Condition 3"]["y"],
                 color='black', linestyle=':', marker='o', markersize=6, fillstyle='none', label='Condition 3')

ax.set_xlim(0, 26)
ax.set_ylim(0, 10)

ax.set_xlabel('Time (hours)', fontsize=12)
ax.set_ylabel('Bacterial Count (CFU/mL) (log10 scale)', fontsize=12)

ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 24])
ax.set_xticklabels(['0', '2', '4', '6', '8', '10', '12', '24'])
ax.set_yticks([2, 4, 6, 8, 9, 10])
ax.set_yticklabels(['2', '4', '6', '8', '9', '10'])

ax.plot([12, 12.5], [0, 10], color='black', linewidth=1.5)
ax.plot([12.5, 13], [0, 10], color='white', linewidth=1.5)
ax.plot([20, 20.5], [0, 10], color='black', linewidth=1.5)

ax.legend(loc='upper left', fontsize=10)

plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()