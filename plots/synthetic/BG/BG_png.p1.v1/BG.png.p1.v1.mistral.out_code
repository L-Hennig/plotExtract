import matplotlib.pyplot as plt

# Data
time = [0, 2, 4, 6, 8, 10, 12, 14]
bacteria_count = [4.8, 9, 11.5, 12, 12, 9.5, 10.5, 11.8]

# Create plot
fig, ax = plt.subplots(figsize=(6, 4))
ax.plot(time, bacteria_count, marker='o', color='#1f77b4', linestyle='-', linewidth=2, markersize=8)

# Axis labels and ranges
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Bacteria Count (CFU/mL)')
ax.set_xlim(0, 14)
ax.set_ylim(0, 13)

# Tick marks
ax.set_xticks(range(0, 15, 2))
ax.set_yticks(range(0, 14, 2))

# Save the plot
plt.savefig(r"C:\Users\Lucas\OneDrive\UCL Internship\PlotExtract\plots\synthetic\BG\BG_png.p1.v1\BG_png-replot.p1.v1.png", bbox_inches='tight', dpi=300)
plt.close()