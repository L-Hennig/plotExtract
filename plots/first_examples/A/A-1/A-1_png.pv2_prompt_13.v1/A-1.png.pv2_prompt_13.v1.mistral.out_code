import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\Plot_Extract\plots\first_examples\A\A-1\A-1_png.pv2_prompt_13.v1\A-1_png-replot.pv2_prompt_13.v1.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data from marker_facts
curves_data = {
    "Blank": [
        (0, 6.2), (2, 8.5), (4, 9.5), (6, 9.8), (8, 10.0), (10, 10.1), (12, 10.2),
        (22, 10.3), (24, 10.3), (26, 10.4)
    ],
    "COL 0.125ug/mL": [
        (0, 6.2), (2, 7.0), (4, 8.0), (6, 8.5), (8, 9.0), (10, 9.5), (12, 9.8),
        (22, 10.0), (24, 10.1), (26, 10.2)
    ],
    "MINO 1ug/mL": [
        (0, 6.2), (2, 6.8), (4, 7.5), (6, 8.0), (8, 8.2), (10, 8.5), (12, 8.7),
        (22, 9.0), (24, 9.0), (26, 9.1)
    ],
    "MEM 4ug/mL": [
        (0, 6.2), (2, 0.5), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0), (12, 0.0),
        (22, 0.0), (24, 0.0), (26, 0.0)
    ],
    "RFP 0.06ug/mL": [
        (0, 6.2), (2, 2.0), (4, 1.0), (6, 0.5), (8, 0.0), (10, 0.0), (12, 0.0),
        (22, 1.0), (24, 1.5), (26, 2.0)
    ],
    "COL 0.125ug/mL + MEM 4ug/mL": [
        (0, 6.2), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0), (12, 0.0),
        (22, 0.0), (24, 0.0), (26, 0.0)
    ],
    "COL 0.125ug/mL + MINO 1ug/mL": [
        (0, 6.2), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0), (12, 0.0),
        (22, 0.0), (24, 0.0), (26, 0.0)
    ],
    "COL 0.125ug/mL + RFP 0.06ug/mL": [
        (0, 6.2), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0), (12, 0.0),
        (22, 0.0), (24, 0.0), (26, 0.0)
    ]
}

# Curve styles from curve_style_facts
curve_styles = {
    "Blank": {"line": "dotted", "marker": "x", "color": "black"},
    "COL 0.125ug/mL": {"line": "solid", "marker": "s", "color": "black"},
    "MINO 1ug/mL": {"line": "dashed", "marker": "^", "color": "black"},
    "MEM 4ug/mL": {"line": "dashdot", "marker": "o", "color": "black"},
    "RFP 0.06ug/mL": {"line": (0, [3, 1, 1, 1, 1, 1]), "marker": "v", "color": "black"},
    "COL 0.125ug/mL + MEM 4ug/mL": {"line": "dotted", "marker": "o", "color": "black"},
    "COL 0.125ug/mL + MINO 1ug/mL": {"line": "dashdot", "marker": "^", "color": "black"},
    "COL 0.125ug/mL + RFP 0.06ug/mL": {"line": (0, [3, 1, 1, 1, 1, 1]), "marker": "v", "color": "black"}
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Plot each curve with its style
for label, points in curves_data.items():
    x_vals = [p[0] for p in points]
    y_vals = [p[1] for p in points]
    style = curve_styles[label]
    ax.plot(x_vals, y_vals,
            linestyle=style["line"],
            marker=style["marker"],
            color=style["color"],
            label=label)

# Set axis limits and ticks
ax.set_xlim(0, 26)
ax.set_ylim(0, 16)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 22, 24, 26])
ax.set_yticks([0, 2, 4, 6, 8, 10, 12, 14, 16])

# Axis labels
ax.set_xlabel("Time (h)")
ax.set_ylabel("Log cfu/mL")

# Add axis break
ax.annotate('', xy=(12, 0), xytext=(12, -1.5),
            arrowprops=dict(arrowstyle='-', color='white', lw=1.5),
            annotation_clip=False)
ax.annotate('', xy=(22, 0), xytext=(22, -1.5),
            arrowprops=dict(arrowstyle='-', color='white', lw=1.5),
            annotation_clip=False)

# Add break lines on x-axis
ax.plot([11.8, 12.2], [-0.5, -0.5], color='black', lw=1)
ax.plot([21.8, 22.2], [-0.5, -0.5], color='black', lw=1)

# Legend
ax.legend(loc='upper left', bbox_to_anchor=(0, 1), frameon=False)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)