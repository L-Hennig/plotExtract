import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\Plot_Extract\plots\first_examples/A/A-1\A-1_png.pv2_prompt_13.v10.key5.web\A-1_png-replot.pv2_prompt_13.v10.key5.web.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data points extracted from the plot
marker_facts = {
    "curves": [
        {
            "curve_label": "Blank",
            "points": [
                (0, 6.0), (2, 9.0), (4, 9.5), (6, 9.8), (8, 10.0),
                (10, 10.0), (12, 10.0), (22, 10.2), (24, 10.3), (26, 10.3)
            ]
        },
        {
            "curve_label": "COL 0.125ug/mL",
            "points": [
                (0, 6.0), (2, 7.0), (4, 8.0), (6, 8.5), (8, 9.0),
                (10, 9.5), (12, 9.8), (22, 10.0), (24, 10.0), (26, 10.1)
            ]
        },
        {
            "curve_label": "MINO 1ug/mL",
            "points": [
                (0, 6.0), (2, 7.5), (4, 8.0), (6, 8.2), (8, 8.5),
                (10, 8.8), (12, 9.0), (22, 9.2), (24, 9.3), (26, 9.5)
            ]
        },
        {
            "curve_label": "MEM 4ug/mL",
            "points": [
                (0, 6.0), (2, 0.5), (4, 0.0), (6, 0.0), (8, 0.0),
                (10, 0.0), (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
            ]
        },
        {
            "curve_label": "RFP 0.06ug/mL",
            "points": [
                (0, 6.0), (2, 2.0), (4, 1.0), (6, 0.5), (8, 0.0),
                (10, 0.0), (12, 0.0), (22, 1.0), (24, 1.5), (26, 2.0)
            ]
        },
        {
            "curve_label": "COL 0.125ug/mL + MEM 4ug/mL",
            "points": [
                (0, 6.0), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0),
                (10, 0.0), (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
            ]
        },
        {
            "curve_label": "COL 0.125ug/mL + MINO 1ug/mL",
            "points": [
                (0, 6.0), (2, 1.0), (4, 1.5), (6, 1.0), (8, 0.5),
                (10, 0.0), (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
            ]
        },
        {
            "curve_label": "COL 0.125ug/mL + RFP 0.06ug/mL",
            "points": [
                (0, 6.0), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0),
                (10, 0.0), (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
            ]
        }
    ]
}

# Create the plot
plt.figure(figsize=(8, 6))

# Define line styles and markers for each curve
line_styles = {
    "Blank": {'linestyle': ':', 'marker': 'x', 'color': 'black'},
    "COL 0.125ug/mL": {'linestyle': '-', 'marker': 's', 'color': 'black'},
    "MINO 1ug/mL": {'linestyle': '--', 'marker': '^', 'color': 'black'},
    "MEM 4ug/mL": {'linestyle': '-.', 'marker': 'o', 'color': 'black'},
    "RFP 0.06ug/mL": {'linestyle': (0, (3, 1, 1, 1)), 'marker': 'v', 'color': 'black'},
    "COL 0.125ug/mL + MEM 4ug/mL": {'linestyle': ':', 'marker': 'o', 'color': 'black'},
    "COL 0.125ug/mL + MINO 1ug/mL": {'linestyle': '--', 'marker': '^', 'markerfacecolor': 'none', 'color': 'black'},
    "COL 0.125ug/mL + RFP 0.06ug/mL": {'linestyle': (0, (3, 1, 1, 1)), 'marker': 'v', 'markerfacecolor': 'none', 'color': 'black'}
}

# Plot each curve
for curve in marker_facts["curves"]:
    points = curve["points"]
    x_vals = [p[0] for p in points]
    y_vals = [p[1] for p in points]
    label = curve["curve_label"]
    style = line_styles[label]

    # Handle axis break by splitting the plot into two segments
    x_left = []
    y_left = []
    x_right = []
    y_right = []
    for x, y in points:
        if x <= 12:
            x_left.append(x)
            y_left.append(y)
        else:
            x_right.append(x)
            y_right.append(y)

    # Plot left segment
    plt.plot(x_left, y_left, label=label, linestyle=style['linestyle'],
             marker=style['marker'], color=style['color'],
             markerfacecolor=style.get('markerfacecolor', 'black'))
    # Plot right segment
    if x_right:
        plt.plot(x_right, y_right, linestyle=style['linestyle'],
                 marker=style['marker'], color=style['color'],
                 markerfacecolor=style.get('markerfacecolor', 'black'))

# Add axis break indication
plt.plot([11.5, 12.5], [0, 0], color='black', linewidth=1)
plt.plot([11.5, 12.5], [16, 16], color='black', linewidth=1)
plt.plot([11.5, 12], [0, 16], color='black', linewidth=1, linestyle='--')
plt.plot([12, 12.5], [0, 16], color='black', linewidth=1, linestyle='--')

# Set axis limits and ticks
plt.xlim(0, 26)
plt.ylim(0, 16)
plt.xticks([0, 2, 4, 6, 8, 10, 12, 22, 24, 26])
plt.yticks([0, 2, 4, 6, 8, 10, 12, 14, 16])

# Axis labels
plt.xlabel("Time (h)")
plt.ylabel("Log cfu/mL")

# Add legend
plt.legend(loc='upper left', bbox_to_anchor=(1, 1))

# Add grid
plt.grid(True, linestyle=':', alpha=0.7)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()