import os
import matplotlib.pyplot as plt
import numpy as np

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\Plot_Extract\plots\first_examples/A/A-1\A-1_png.pv2_prompt_13.v5.key4.web\A-1_png-replot.pv2_prompt_13.v5.key4.web.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data points from re_extraction results
curve_data = {
    "Blank": [
        (0, 6.0), (2, 8.5), (4, 9.5), (6, 9.8), (8, 10.0), (10, 10.2),
        (12, 10.3), (22, 10.5), (24, 10.6), (26, 10.7)
    ],
    "COL 0.125µg/mL": [
        (0, 6.0), (2, 5.0), (4, 8.0), (6, 8.5), (8, 9.0), (10, 9.2),
        (12, 9.3), (22, 9.5), (24, 9.6), (26, 9.7)
    ],
    "MINO 1µg/mL": [
        (0, 6.0), (2, 4.5), (4, 8.0), (6, 8.2), (8, 8.5), (10, 8.7),
        (12, 8.8), (22, 9.0), (24, 9.1), (26, 9.2)
    ],
    "MEM 4µg/mL": [
        (0, 6.0), (2, 5.5), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0),
        (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
    ],
    "RFP 0.06µg/mL": [
        (0, 6.0), (2, 4.0), (4, 2.0), (6, 1.0), (8, 0.5), (10, 0.0),
        (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
    ],
    "COL 0.125µg/mL + MEM 4µg/mL": [
        (0, 6.0), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0),
        (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
    ],
    "COL 0.125µg/mL + MINO 1µg/mL": [
        (0, 6.0), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0),
        (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
    ],
    "COL 0.125µg/mL + RFP 0.06µg/mL": [
        (0, 6.0), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0), (10, 0.0),
        (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
    ]
}

# Curve styles from curve_style_facts
curve_styles = {
    "Blank": {"color": "black", "linestyle": ":", "marker": "x", "linewidth": 1},
    "COL 0.125µg/mL": {"color": "black", "linestyle": "-", "marker": "s", "linewidth": 1},
    "MINO 1µg/mL": {"color": "black", "linestyle": "--", "marker": "^", "linewidth": 1},
    "MEM 4µg/mL": {"color": "black", "linestyle": "-.", "marker": "o", "linewidth": 1},
    "RFP 0.06µg/mL": {"color": "black", "linestyle": ":", "marker": "v", "linewidth": 1},
    "COL 0.125µg/mL + MEM 4µg/mL": {"color": "black", "linestyle": "-.", "marker": "o", "linewidth": 1},
    "COL 0.125µg/mL + MINO 1µg/mL": {"color": "black", "linestyle": "--", "marker": "^", "linewidth": 1},
    "COL 0.125µg/mL + RFP 0.06µg/mL": {"color": "black", "linestyle": ":", "marker": "v", "linewidth": 1}
}

# Create figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Plot each curve with its specific style
for label, points in curve_data.items():
    x_vals, y_vals = zip(*points)
    ax.plot(x_vals, y_vals,
            linestyle=curve_styles[label]["linestyle"],
            marker=curve_styles[label]["marker"],
            color=curve_styles[label]["color"],
            linewidth=curve_styles[label]["linewidth"],
            label=label)

# Set axis limits and ticks
ax.set_xlim(0, 26)
ax.set_xticks([0, 2, 4, 6, 8, 10, 12, 22, 24, 26])
ax.set_xticklabels(["0", "2", "4", "6", "8", "10", "12", "22", "24", "26"])

ax.set_ylim(0, 16)
ax.set_yticks([0, 2, 4, 6, 8, 10, 12, 14, 16])
ax.set_yticklabels(["0", "2", "4", "6", "8", "10", "12", "14", "16"])

# Add axis break indicator
ax.plot([12, 12], [15.5, 16], color="black", linewidth=1)
ax.plot([22, 22], [15.5, 16], color="black", linewidth=1)
ax.plot([12, 22], [15.5, 15.5], color="black", linewidth=1)
ax.plot([12, 22], [16, 16], color="black", linewidth=1)

# Axis labels
ax.set_xlabel("Time (h)", fontsize=12)
ax.set_ylabel("Log cfu/mL", fontsize=12)

# Title
ax.set_title("A", loc="left", fontsize=14, fontweight="bold")

# Legend
ax.legend(loc="upper left", fontsize=8, frameon=False)

# Grid
ax.grid(True, linestyle="--", alpha=0.6)

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)