import os
import matplotlib.pyplot as plt

replot_path = r"C:\Users\Lucas\OneDrive\UCL Internship\Plot_Extract\plots\first_examples/A/A-1\A-1_png.pv2_prompt_13.v9.key5.web\A-1_png-replot.pv2_prompt_13.v9.key5.web.png"
os.makedirs(os.path.dirname(replot_path), exist_ok=True)

# Data points extracted from the re_extraction results and curve facts
marker_facts = {
    "curves": [
        {
            "curve_label": "Blank",
            "colour": "black",
            "line_type": ":",
            "marker_symbol": "x",
            "points": [
                (0, 6.0), (2, 8.5), (4, 9.5), (6, 10.0), (8, 10.0),
