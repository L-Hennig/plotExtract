                (0, 6.0), (2, 0.0), (4, 0.0), (6, 0.0), (8, 0.0),
                (10, 0.0), (12, 0.0), (22, 0.0), (24, 0.0), (26, 0.0)
            ]
        }
    ]
}

# Create the plot
plt.figure(figsize=(8, 6))

# Plot each curve with its specific style
for curve in marker_facts["curves"]:
    x, y = zip(*curve["points"])
    linestyle = curve["line_type"]
    marker = curve["marker_symbol"]
    label = curve["curve_label"]
    plt.plot(x, y, linestyle=linestyle, marker=marker, color="black", label=label, markersize=6)

# Axis labels
plt.xlabel("Time (h)")
plt.ylabel("Log cfu/mL")

# Axis limits
plt.xlim(0, 26)
plt.ylim(0, 16)

# Ticks
plt.xticks([0, 2, 4, 6, 8, 10, 12, 22, 24, 26])
plt.yticks([0, 2, 4, 6, 8, 10, 12, 14, 16])

# Axis break indication
plt.axvline(x=12, ymin=0.45, ymax=0.55, color='black', linewidth=1.5)
plt.axvline(x=22, ymin=0.45, ymax=0.55, color='black', linewidth=1.5)

# Add legend
plt.legend(loc='upper left', bbox_to_anchor=(1, 1))

# Save the plot
plt.savefig(replot_path, bbox_inches='tight', dpi=300)
plt.close()