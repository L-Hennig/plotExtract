            ]
        },
        {
            "curve_label": "RFP 0.06ug/mL",
            "colour": "black",
            "line_type": ":",
            "marker_symbol": "v",
            "points": [
                (0, 6.0), (2, 7.0), (4, 8.0), (6, 8.5), (8, 8.5),
                (10, 8.5), (12, 9.0), (22, 0.0), (24, 0.0), (26, 0.0)
            ]
        },
        {
