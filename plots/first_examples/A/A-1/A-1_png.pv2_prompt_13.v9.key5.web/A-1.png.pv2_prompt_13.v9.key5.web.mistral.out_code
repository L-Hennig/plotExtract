            ]
        },
        {
            "curve_label": "MINO 1ug/mL",
            "colour": "black",
            "line_type": "--",
            "marker_symbol": "^",
            "points": [
                (0, 6.0), (2, 7.5), (4, 8.0), (6, 8.5), (8, 8.5),
